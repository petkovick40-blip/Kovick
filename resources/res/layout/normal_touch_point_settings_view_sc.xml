<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.NormalTouchPointComponentSettingsViewSC xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/component_settings_view_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keymap_component_settings_intro_title"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="7dp"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:id="@+id/textView4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/normal_touch_point_settings_prompt"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:src="@drawable/white_dotted_line"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="65dp"
                    android:layout_height="match_parent"
                    android:text="@string/normal_touch_point_settings_view_sc_text1"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/nameTextView"
                    android:layout_width="65dp"
                    android:layout_height="match_parent"
                    android:text="@string/empty"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textStyle="bold"
                    android:textColor="@color/component_settings_view_background"
                    android:id="@+id/changeNameButton"
                    android:background="@drawable/button_rounded_white"
                    android:layout_width="@dimen/button_width_phone"
                    android:layout_height="@dimen/button_height_phone"
                    android:text="@string/modify"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_phone">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="65dp"
                    android:layout_height="match_parent"
                    android:text="@string/type_with_colon"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
                <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/triggerTypeSegmentedControl"
                    android:background="@color/settings_segmented_control_background"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:elevation="0dp"
                    app:borderColor="@color/settings_segmented_control_background"
                    app:borderWidth="0dp"
                    app:divider="@color/settings_segmented_control_divider"
                    app:dividerPadding="5dp"
                    app:dividerWidth="1dp"
                    app:draggable="true"
                    app:position="0"
                    app:radius="5dp"
                    app:ripple="true"
                    app:rippleColor="@color/white"
                    app:selectedBackground="@color/white"
                    app:selectionAnimationDuration="200">
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/key_type_shadow"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_text_phone"/>
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/key_type_bind_key"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_text_phone"/>
                </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/bindKeyLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="65dp"
                    android:layout_height="match_parent"
                    android:text="@string/component_settings_bind_key"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/mouseLockKeyTextView"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:text="@string/empty"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
                <Button
                    android:textSize="12dp"
                    android:textColor="@color/component_settings_view_background"
                    android:id="@+id/changeMouseLockKeyButton"
                    android:background="@drawable/button_rounded_white"
                    android:layout_width="@dimen/button_width_phone"
                    android:layout_height="@dimen/button_height_phone"
                    android:text="@string/modify"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/blockTouchLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="65dp"
                    android:layout_height="match_parent"
                    android:text="@string/block_touch"/>
                <Switch
                    android:id="@+id/blockTouchSwitch"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:thumbTint="@drawable/switch_thumb"
                    android:trackTint="@drawable/switch_track"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="65dp"
                    android:layout_height="match_parent"
                    android:text="@string/normal_touch_point_settings_view_sc_text2"/>
                <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                    android:id="@+id/pressPointCountSlider"
                    android:layout_width="@dimen/slider_width_phone"
                    android:layout_height="@dimen/slider_height_phone"
                    app:sliderMax="10"
                    app:sliderMin="0"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:src="@drawable/white_dotted_line"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/normal_touch_point_key_type"/>
                <Space
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"/>
                <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/typeSegmentedControl"
                    android:background="@color/settings_segmented_control_background"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height_phone"
                    android:elevation="0dp"
                    app:borderColor="@color/settings_segmented_control_background"
                    app:borderWidth="0dp"
                    app:divider="@color/settings_segmented_control_divider"
                    app:dividerPadding="5dp"
                    app:dividerWidth="1dp"
                    app:draggable="true"
                    app:position="0"
                    app:radius="5dp"
                    app:ripple="true"
                    app:rippleColor="@color/white"
                    app:selectedBackground="@color/white"
                    app:selectionAnimationDuration="200">
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/normal_touch_point_key_type1"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_text_phone"/>
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/normal_touch_point_key_type2"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_text_phone"/>
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/normal_touch_point_key_type3"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_text_phone"/>
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/normal_touch_point_key_type4"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_text_phone"/>
                </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/typeHelpIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_help"
                    android:tint="@color/white"
                    android:layout_weight="0"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/timeInsideClickSettingsStack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/slider_height_phone">
                    <TextView
                        android:textSize="@dimen/font_size_subtext_phone"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/normal_touch_point_text1"/>
                    <Space
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"/>
                    <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                        android:id="@+id/clickDurationSliderView"
                        android:layout_width="@dimen/slider_width_phone"
                        android:layout_height="match_parent"/>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <ImageView
                        android:id="@+id/clickDurationHelpIcon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_help"
                        android:tint="@color/white"
                        android:layout_weight="0"/>
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="7dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/timeBetweenClickSettingsStack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/slider_height_phone">
                    <TextView
                        android:textSize="@dimen/font_size_subtext_phone"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/normal_touch_point_text2"/>
                    <Space
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"/>
                    <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                        android:id="@+id/clickIntervalSliderView"
                        android:layout_width="@dimen/slider_width_phone"
                        android:layout_height="match_parent"/>
                    <Space
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <ImageView
                        android:id="@+id/clickIntervalHelpIcon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_help"
                        android:tint="@color/white"
                        android:layout_weight="0"/>
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/conditionalCrazyTapSettingsStack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/slider_height_phone"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/font_size_subtext_phone"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/normal_touch_point_text4"/>
                    <Space
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"/>
                    <Switch
                        android:id="@+id/conditionalCrazyTapSwitch"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:thumbTint="@drawable/switch_thumb"
                        android:trackTint="@drawable/switch_track"/>
                    <Space
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="@dimen/font_size_subtext_phone"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:id="@+id/textView19"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/normal_touch_point_text5"/>
                    <Space
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"/>
                    <Button
                        android:textColor="@color/jy_blue_1"
                        android:id="@+id/editCrazyTapWeaponsButton"
                        android:background="@drawable/rounded_button_background_5dp"
                        android:layout_width="60dp"
                        android:layout_height="match_parent"
                        android:text="@string/normal_touch_point_text6"
                        android:backgroundTint="@color/white"/>
                    <Space
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_help"
                        android:tint="@color/white"
                        android:layout_weight="0"/>
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:src="@drawable/white_dotted_line"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/pubgRelatedSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/normal_touch_point_text20"
                        android:layout_weight="0"
                        android:paddingEnd="20dp"/>
                    <Space
                        android:layout_width="20dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"/>
                    <Switch
                        android:id="@+id/performAimingRecognitionSwitch"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:thumbTint="@drawable/switch_thumb"
                        android:trackTint="@drawable/switch_track"/>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_help"
                        android:tint="@color/white"
                        android:layout_weight="0"/>
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_weight="0"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/normal_touch_point_settings_view_sc_text3"
                        android:layout_weight="0"
                        android:paddingEnd="20dp"/>
                    <Space
                        android:layout_width="20dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"/>
                    <Switch
                        android:id="@+id/bindStartRecoilControlSwitch"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:thumbTint="@drawable/switch_thumb"
                        android:trackTint="@drawable/switch_track"/>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_help"
                        android:tint="@color/white"
                        android:layout_weight="0"/>
                </LinearLayout>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_weight="0"/>
        </LinearLayout>
    </ScrollView>
</com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.NormalTouchPointComponentSettingsViewSC>
