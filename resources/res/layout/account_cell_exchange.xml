<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp">
    <View
        android:background="@drawable/account_page_card_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/account_primary_color"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/account_card_padding"
        android:text="@string/account_page_exchange"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/button_background"
        android:background="@drawable/account_page_exchange_button_background"
        android:layout_width="64dp"
        android:layout_height="40dp"
        android:layout_marginEnd="6dp"
        android:backgroundTint="@color/account_primary_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/description_image"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/account_arrow_right"
        app:layout_constraintBottom_toBottomOf="@+id/button_background"
        app:layout_constraintEnd_toEndOf="@+id/button_background"
        app:layout_constraintStart_toStartOf="@+id/button_background"
        app:layout_constraintTop_toTopOf="@+id/button_background"/>
</androidx.constraintlayout.widget.ConstraintLayout>
