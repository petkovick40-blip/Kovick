<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cellContainer"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:id="@+id/titleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/select_keymap_table_row_text1"
                android:maxLength="50"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_weight="0"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/font_size_subtext_phone"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_keymap_table_row_text2"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:id="@+id/componentCountTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-1"
                    android:layout_weight="0"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/font_size_subtext_phone"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_keymap_table_row_text3"/>
                <TextView
                    android:textSize="@dimen/font_size_subtext_phone"
                    android:textColor="@color/white"
                    android:id="@+id/editDateTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2022-01-20"/>
            </LinearLayout>
        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_weight="0"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/jy_blue_1"
                    android:id="@+id/shareButton"
                    android:background="@drawable/rounded_button_background_10dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="65dp"
                    android:layout_height="25dp"
                    android:text="@string/share"
                    android:drawableLeft="@drawable/select_keymap_share_icon"
                    android:drawablePadding="4dp"
                    android:layout_weight="0"
                    android:textAlignment="viewStart"
                    android:backgroundTint="@color/white"
                    android:drawableTint="@color/jy_blue_1"
                    android:autoSizeTextType="uniform"
                    android:autoSizePresetSizes="12sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeMaxTextSize="12sp"
                    app:iconGravity="textStart"/>
                <Space
                    android:layout_width="3dp"
                    android:layout_height="5dp"/>
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/jy_blue_1"
                    android:id="@+id/renameButton"
                    android:background="@drawable/rounded_button_background_10dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="65dp"
                    android:layout_height="25dp"
                    android:text="@string/rename"
                    android:drawableLeft="@drawable/select_keymap_rename_icon"
                    android:drawablePadding="0dp"
                    android:layout_weight="0"
                    android:backgroundTint="@color/white"
                    android:drawableTint="@color/jy_blue_1"
                    android:autoSizeTextType="uniform"
                    android:autoSizePresetSizes="12sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeMaxTextSize="12sp"/>
            </LinearLayout>
            <Space
                android:layout_width="5dp"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:id="@+id/deleteButton"
                    android:background="@drawable/rounded_button_background_10dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="65dp"
                    android:layout_height="25dp"
                    android:text="@string/delete"
                    android:drawableLeft="@drawable/select_keymap_delete_icon"
                    android:drawablePadding="0dp"
                    android:layout_weight="0"
                    android:backgroundTint="@color/system_red"
                    android:drawableTint="@color/white"
                    android:autoSizeTextType="uniform"
                    android:autoSizePresetSizes="12sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeMaxTextSize="12sp"/>
                <Space
                    android:layout_width="20dp"
                    android:layout_height="5dp"/>
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/jy_blue_1"
                    android:id="@+id/applyButton"
                    android:background="@drawable/rounded_button_background_10dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="65dp"
                    android:layout_height="25dp"
                    android:text="@string/apply"
                    android:drawableLeft="@drawable/select_keymap_apply_icon"
                    android:drawablePadding="0dp"
                    android:layout_weight="0"
                    android:backgroundTint="@color/white"
                    android:drawableTint="@color/jy_blue_1"
                    android:autoSizeTextType="uniform"
                    android:autoSizePresetSizes="12sp"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeMaxTextSize="12sp"/>
                <Space
                    android:layout_width="5dp"
                    android:layout_height="0dp"
                    android:layout_weight="0"/>
            </LinearLayout>
        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/correctIcon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_correct"
        android:tint="@color/white"
        android:layout_weight="0"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
