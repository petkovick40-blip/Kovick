<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.module.keymapeditor.macro.macrooperationeditorview.SwipeMacroEditorView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_button_background_5dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/white">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/jy_blue_1"
            android:gravity="center_vertical"
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/macro_operation_view_swipe"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/font_size_text_phone"
            android:gravity="center_vertical"
            android:id="@+id/positionTextView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/font_size_subtext_phone"
                android:gravity="center_vertical"
                android:id="@+id/positionTextView3"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/macro_operation_view_click_duration"
                android:layout_weight="0"/>
            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:layout_weight="0"/>
            <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                android:id="@+id/slider"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:layout_weight="0"
                app:mainColor="@color/jy_blue_1"
                app:seekbarDrawable="@drawable/thick_seek_bar_phone_blue"
                app:thumbDrawable="@drawable/thick_seek_bar_thumb_phone_blue"/>
            <Space
                android:layout_width="20dp"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/font_size_subtext_phone"
                android:gravity="center_vertical"
                android:id="@+id/positionTextView4"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/macro_operation_view_swipe_text1"
                android:layout_weight="0"/>
            <Space
                android:layout_width="5dp"
                android:layout_height="wrap_content"
                android:layout_weight="0"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0">
                <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/typeSegmentedControl"
                    android:background="#fff8f8f8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="0dp"
                    app:borderColor="@color/jy_blue_1"
                    app:borderWidth="0dp"
                    app:divider="@color/settings_segmented_control_divider"
                    app:dividerPadding="5dp"
                    app:dividerWidth="1dp"
                    app:draggable="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.5"
                    app:position="0"
                    app:radius="5dp"
                    app:ripple="true"
                    app:rippleColor="@color/white"
                    app:selectedBackground="@color/jy_blue_1"
                    app:selectionAnimationDuration="200">
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_phone"
                        android:layout_weight="1"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/white"
                        app:selectedTextStyle="bold"
                        app:text="@string/macro_operation_view_swipe_text2"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_subtext_phone"/>
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_phone"
                        android:layout_weight="1"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/white"
                        app:selectedTextStyle="bold"
                        app:text="@string/macro_operation_view_swipe_text3"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_subtext_phone"/>
                </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:textSize="@dimen/font_size_text_phone"
        android:textColor="@color/white"
        android:id="@+id/changePositionButton"
        android:background="@drawable/rounded_button_background_15dp"
        android:layout_width="80dp"
        android:layout_height="30dp"
        android:text="@string/macro_operation_view_change_position"
        android:layout_marginEnd="80dp"
        android:backgroundTint="@color/jy_blue_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
</com.zjx.jyandroid.module.keymapeditor.macro.macrooperationeditorview.SwipeMacroEditorView>
