<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/baseView"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/jy_blue_1"
    app:cardCornerRadius="10dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp">
        <TextView
            android:textColor="@color/white"
            android:id="@+id/titleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Annual Subscription"
            android:layout_weight="1"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/priceTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$20"
            android:layout_weight="1"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/recommendImage"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:tint="#ffffa07a"
                android:elevation="10dp"
                app:layout_constraintStart_toStartOf="@+id/button"
                app:layout_constraintTop_toTopOf="@+id/button"
                app:srcCompat="@drawable/ic_thumb_up"/>
            <Button
                android:textColor="@color/white"
                android:id="@+id/button"
                android:layout_width="80dp"
                android:layout_height="39dp"
                android:text="@string/account_page_view_subscription_component_purchase"
                android:layout_weight="1"
                android:backgroundTint="@color/success_green"
                android:autoSizeTextType="uniform"
                android:autoSizePresetSizes="12sp"
                android:autoSizeMinTextSize="6sp"
                android:autoSizeMaxTextSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
