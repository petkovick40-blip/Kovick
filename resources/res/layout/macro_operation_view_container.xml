<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.Macro.MacroOperationViews.MacroOperationViewContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:weightSum="100">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_weight="20">
                <ImageView
                    android:id="@+id/deleteButton"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_delete_icon"
                    android:tint="@color/danger_red"/>
                <Space
                    android:layout_width="5dp"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/indexTextView"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="（1）"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/moveUpView"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:src="@drawable/arrow_up"
                android:tint="@color/white"
                android:layout_weight="40"/>
            <ImageView
                android:id="@+id/moveDownView"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:src="@drawable/arrow_down"
                android:tint="@color/white"
                android:layout_weight="40"/>
        </LinearLayout>
    </LinearLayout>
</com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.Macro.MacroOperationViews.MacroOperationViewContainer>
