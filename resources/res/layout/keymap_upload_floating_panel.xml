<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.module.keymapeditor.KeymapUploadPanelView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="100"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">
        <androidx.cardview.widget.CardView
            android:background="#cf4f6bf8"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="100"
            app:cardBackgroundColor="#cf4f6bf8"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:weightSum="6">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/keymapUploadPanelExitLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:weightSum="100"
                    android:layout_weight="1">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="80">
                        <ImageView
                            android:id="@+id/selectKeymapImageView"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:src="@drawable/uploadkeymappanel_exit_icon"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true"
                            android:contentDescription="exit_icon"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="#ffffffff"
                        android:id="@+id/selectKeymapTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/exit"
                        android:layout_weight="1"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/keymapUploadPanelUnlockLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:weightSum="100"
                    android:layout_weight="1">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="80">
                        <ImageView
                            android:id="@+id/unlockIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:src="@drawable/uploadkeymappanel_unlock_icon"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true"
                            android:contentDescription="unlock_icon"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="#ffffffff"
                        android:id="@+id/unlockButtonTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/keymap_upload_floating_panel_unlock_background"
                        android:layout_weight="1"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/keymapUploadPanelAddMacroLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:weightSum="100"
                    android:layout_weight="1">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="80">
                        <ImageView
                            android:id="@+id/recognizationUploadImageView"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:src="@drawable/uploadkeymappanel_add_icon"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true"
                            android:contentDescription="add_icon"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="#ffffffff"
                        android:id="@+id/recognizationUploadTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/keymap_upload_floating_panel_add"
                        android:layout_weight="1"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/dynamicKeymapLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:weightSum="100"
                    android:layout_weight="1">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="80">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:src="@drawable/uploadkeymappanel_dynamic_keymap_icon"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true"
                            android:contentDescription="add_icon"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="#ffffffff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/keymap_upload_floating_panel_dynamic_keymap"
                        android:layout_weight="1"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/keymapUploadPanelResetLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:weightSum="100"
                    android:layout_weight="1">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="80">
                        <ImageView
                            android:id="@+id/settingsImageView"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:src="@drawable/uploadkeymappanel_reset_icon"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true"
                            android:contentDescription="reset_icon"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="#ffffffff"
                        android:id="@+id/settingsTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reset"
                        android:layout_weight="1"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/keymapUploadPanelSaveLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:weightSum="100"
                    android:layout_weight="1">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="80">
                        <ImageView
                            android:id="@+id/returnImageView"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:src="@drawable/uploadkeymappanel_save_icon"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true"
                            android:contentDescription="save_icon"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="#ffffffff"
                        android:id="@+id/returnTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/save"
                        android:layout_weight="1"
                        android:textAlignment="center"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</com.zjx.jyandroid.module.keymapeditor.KeymapUploadPanelView>
