<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.MainApp.MainPageView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/navigationBar"
            android:background="@color/navigation_bar_background"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <Space
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/jiayingyouxiting"
                android:layout_weight="0"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <View
            android:id="@+id/view"
            android:background="#2a000000"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/deviceInfoLayout"
            android:background="@drawable/rounded_button_background_10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="15dp"
            android:backgroundTint="@color/default_jy_blue">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/linearLayout2"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:layout_marginStart="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/deviceImageView"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/deviceInfoTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_page_view_text1"
                    android:layout_weight="0"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:textColor="@color/white"
                android:id="@+id/connectionStatusButton"
                android:background="@drawable/rounded_button_background_5dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="@string/state_not_connected"
                android:layout_marginEnd="10dp"
                android:backgroundTint="@color/jy_blue_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/switchModeLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="20dp">
            <Space
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/jy_blue_1"
                android:gravity="right"
                android:id="@+id/switchModeButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/main_page_view_text4"
                android:drawableLeft="@drawable/main_page_view_switch_drawable_wrapper"
                android:drawablePadding="2dp"
                android:layout_marginEnd="15dp"
                android:drawableTint="@color/jy_blue_1"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/adbNeedView"
            android:background="@drawable/rounded_button_background_10dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:backgroundTint="#ffced6fb">
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:id="@+id/textView11"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/adb_not_loaded_prompt_main_page_view"
                android:layout_marginStart="15dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textColor="@color/white"
                android:id="@+id/loadAdbActivityButton"
                android:background="@drawable/rounded_button_background_5dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="@string/go_adb_manage_view_main_page_view"
                android:layout_marginEnd="10dp"
                android:backgroundTint="@color/jy_blue_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="5dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/permissionNeedView"
            android:background="@drawable/rounded_button_background_10dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:backgroundTint="#ffced6fb">
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/need_permission_main_page_view"
                android:layout_marginStart="15dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textColor="@color/white"
                android:id="@+id/loadPermissionAcitivityButton"
                android:background="@drawable/rounded_button_background_5dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="@string/go_permission_manage_view_main_page_view"
                android:layout_marginEnd="10dp"
                android:backgroundTint="@color/jy_blue_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="5dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/OtaNeedView"
            android:background="@drawable/rounded_button_background_10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:backgroundTint="#ffced6fb">
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/main_page_view_text2"
                android:layout_marginStart="15dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textColor="@color/white"
                android:id="@+id/loadOtaActivityButton"
                android:background="@drawable/rounded_button_background_5dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="@string/main_page_view_text3"
                android:layout_marginEnd="10dp"
                android:backgroundTint="@color/jy_blue_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="15dp"
                android:text="@string/game_list_main_page_view"/>
            <ImageView
                android:id="@+id/addButton"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/main_page_view_add_icon"
                android:layout_weight="0"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <com.evrencoskun.tableview.TableView
            android:id="@+id/myGamesTableView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="10dp"
            app:allow_click_inside_cell="true"
            app:column_header_height="0dp"
            app:row_header_width="0dp"
            app:selected_color="#10000000"
            app:separator_color="#3a000000"
            app:show_horizontal_separator="false"
            app:show_vertical_separator="true"
            app:unselected_color="@color/transparent"/>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:id="@+id/reasonOfAdsTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_page_view_reason_of_ads"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.zjx.jyandroid.MainApp.MainPageView>
