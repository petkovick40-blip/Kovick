<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/background"
        android:background="@drawable/rounded_button_background_15dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:backgroundTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/card_view"
        android:background="@drawable/rounded_button_background_15dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="-30dp"
        android:backgroundTint="#ff2ecde2"
        app:layout_constraintBottom_toBottomOf="@+id/login_image"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/login_image"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/account_app_icon"
        android:scaleType="fitXY"
        android:layout_marginStart="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/login_in"
        android:background="@drawable/account_login_button_background"
        android:layout_width="112dp"
        android:layout_height="40dp"
        android:text="@string/account_login"
        android:maxLines="1"
        android:layout_marginEnd="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/login_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/login_image"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/account_primary_color"
        android:id="@+id/expire_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/account_page_please_login"
        android:maxLines="1"
        android:layout_marginHorizontal="@dimen/account_card_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
