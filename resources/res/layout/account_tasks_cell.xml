<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffffff"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <View
        android:id="@+id/image_background"
        android:background="@drawable/account_page_task_image_background"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/account_card_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/image"
        android:background="@drawable/ic_account_growth_value"
        android:layout_width="29dp"
        android:layout_height="29dp"
        app:layout_constraintBottom_toBottomOf="@+id/image_background"
        app:layout_constraintEnd_toEndOf="@+id/image_background"
        app:layout_constraintStart_toStartOf="@+id/image_background"
        app:layout_constraintTop_toTopOf="@+id/image_background"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/account_primary_color"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="2"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toStartOf="@+id/button"
        app:layout_constraintStart_toEndOf="@+id/image_background"
        app:layout_constraintTop_toTopOf="@+id/image_background"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ffe0a000"
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+2"
        app:layout_constraintBottom_toBottomOf="@+id/image_background"
        app:layout_constraintStart_toStartOf="@+id/title"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/button"
        android:background="@drawable/account_page_card_background"
        android:layout_width="80dp"
        android:layout_height="28dp"
        android:layout_marginEnd="@dimen/account_card_padding"
        android:backgroundTint="#ff2b6eff"
        app:layout_constraintBottom_toBottomOf="@+id/image_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/image_background"/>
    <View
        android:id="@+id/red_point"
        android:background="@drawable/ic_red_point"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="@+id/button"
        app:layout_constraintTop_toTopOf="@+id/button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
