<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.Extensions.GeneralRC.GeneralRCExtensionSettingsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:background="@color/jy_blue_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="18dp">
                <TextView
                    android:textSize="@dimen/font_size_subtext_phone"
                    android:textColor="@color/jy_blue_1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/pubg_settings_header1"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.zjx.jyandroid.base.Components.TextWithSwitchView
                    android:id="@+id/enableRecoilControlCell"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    app:showSubtitle="false"
                    app:titleSize="@dimen/font_size_text_phone"
                    app:titleText="@string/general_rc_extension_settings_view_text1"
                    app:titleTextColor="#ffffffff"/>
                <View
                    android:id="@+id/view7"
                    android:background="#6affffff"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <com.zjx.jyandroid.base.Components.TextWithSwitchView
                    android:id="@+id/showPanelCell"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    app:showSubtitle="false"
                    app:titleSize="@dimen/font_size_text_phone"
                    app:titleText="@string/pubg_settings_text2"
                    app:titleTextColor="#ffffffff"/>
                <View
                    android:background="#6affffff"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <com.zjx.jyandroid.base.Components.TextWithSwitchView
                    android:id="@+id/fixPanelCell"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    app:showSubtitle="false"
                    app:titleSize="@dimen/font_size_text_phone"
                    app:titleText="@string/pubg_settings_text3"
                    app:titleTextColor="#ffffffff"/>
                <View
                    android:id="@+id/view12"
                    android:background="#6affffff"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_weight="1"/>
                <com.zjx.jyandroid.base.Components.TextWithSliderView
                    android:id="@+id/panelTransparencyCell"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    app:showSubtitle="false"
                    app:sliderMax="100"
                    app:sliderMin="10"
                    app:subtitleSize="@dimen/font_size_subtext_phone"
                    app:subtitleText="@string/pubg_settings_text4"
                    app:subtitleTextColor="#ffffffff"
                    app:titleSize="@dimen/font_size_text_phone"
                    app:titleText="@string/pubg_settings_text30"
                    app:titleTextColor="#ffffffff"/>
                <View
                    android:id="@+id/view5"
                    android:background="#6affffff"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_weight="1"/>
                <com.zjx.jyandroid.base.Components.TextWithSliderView
                    android:id="@+id/dataPercentageCell"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    app:showSubtitle="true"
                    app:sliderMax="200"
                    app:sliderMin="40"
                    app:subtitleSize="@dimen/font_size_subtext_phone"
                    app:subtitleText="@string/pubg_settings_text4"
                    app:subtitleTextColor="#ffffffff"
                    app:titleSize="@dimen/font_size_text_phone"
                    app:titleText="@string/pubg_settings_text5"
                    app:titleTextColor="#ffffffff"/>
                <View
                    android:id="@+id/view14"
                    android:background="#6affffff"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_weight="1"/>
                <com.zjx.jyandroid.base.Components.TextViewComponent
                    android:id="@+id/RCDataManageCell"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    app:rightText="&gt;   "
                    app:rightTextColor="@color/white"
                    app:rightTextSize="15sp"
                    app:showSubtitle="false"
                    app:titleSize="@dimen/font_size_text_phone"
                    app:titleText="@string/pubg_settings_text6"
                    app:titleTextColor="#ffffffff"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/wangzuoSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="@dimen/font_size_subtext_phone"
                        android:textColor="@color/jy_blue_1"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="身姿快捷键"
                        android:layout_marginStart="10dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/bindGestureLinearLayout"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.zjx.jyandroid.base.Components.BindKeyRow
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"/>
                    <com.zjx.jyandroid.base.Components.BindKeyRow
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"/>
                    <com.zjx.jyandroid.base.Components.BindKeyRow
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"/>
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="@dimen/font_size_subtext_phone"
                        android:textColor="@color/jy_blue_1"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/general_rc_extension_settings_view_text2"
                        android:layout_marginStart="10dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/bindKeyLinearLayout"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.zjx.jyandroid.base.Components.BindKeyRow
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"/>
                    <com.zjx.jyandroid.base.Components.BindKeyRow
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"/>
                    <com.zjx.jyandroid.base.Components.BindKeyRow
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"/>
                    <com.zjx.jyandroid.base.Components.BindKeyRow
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"/>
                    <com.zjx.jyandroid.base.Components.BindKeyRow
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"/>
                    <com.zjx.jyandroid.base.Components.BindKeyRow
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"/>
                    <com.zjx.jyandroid.base.Components.BindKeyRow
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"/>
                    <com.zjx.jyandroid.base.Components.BindKeyRow
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"/>
                    <com.zjx.jyandroid.base.Components.BindKeyRow
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"/>
                    <com.zjx.jyandroid.base.Components.BindKeyRow
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.zjx.jyandroid.Extensions.GeneralRC.GeneralRCExtensionSettingsView>
