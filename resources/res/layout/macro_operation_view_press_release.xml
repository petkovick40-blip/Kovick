<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.module.keymapeditor.macro.macrooperationeditorview.PressReleaseMacroOperationEditorView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_button_background_5dp"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:backgroundTint="@color/white">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/jy_blue_1"
            android:gravity="center_vertical"
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/font_size_subtext_phone"
            android:gravity="center_vertical"
            android:id="@+id/positionTextView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <Button
        android:textSize="@dimen/font_size_text_phone"
        android:textColor="@color/white"
        android:id="@+id/changePositionButton"
        android:background="@drawable/rounded_button_background_15dp"
        android:layout_width="80dp"
        android:layout_height="30dp"
        android:text="@string/macro_operation_view_change_position"
        android:layout_marginEnd="80dp"
        android:backgroundTint="@color/jy_blue_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
</com.zjx.jyandroid.module.keymapeditor.macro.macrooperationeditorview.PressReleaseMacroOperationEditorView>
