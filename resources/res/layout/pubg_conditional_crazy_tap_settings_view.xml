<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.Extensions.pubg.componentsettingsview.ConditionalCrazyTapComponentSettingsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/component_settings_view_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keymap_component_settings_intro_title"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="此功能可触发条件连点"/>
        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp"/>
        <ImageView
            android:id="@+id/imageView9"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:src="@drawable/white_dotted_line"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp"/>
        <com.zjx.jyandroid.base.Components.ModifyBindingKeyComponent
            android:orientation="horizontal"
            android:id="@+id/modifyBindingKeyComponent"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="25dp">
            <TextView
                android:textSize="@dimen/font_size_subtext_phone"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/textView19"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/normal_touch_point_text5"/>
            <Space
                android:layout_width="20dp"
                android:layout_height="wrap_content"/>
            <Button
                android:textColor="@color/jy_blue_1"
                android:id="@+id/editCrazyTapWeaponsButton"
                android:background="@drawable/rounded_button_background_5dp"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:text="@string/normal_touch_point_text6"
                android:backgroundTint="@color/white"/>
            <Space
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_help"
                android:tint="@color/white"
                android:layout_weight="0"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/timeInsideClickSettingsStack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/slider_height_phone">
                <TextView
                    android:textSize="@dimen/font_size_subtext_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/normal_touch_point_text1"/>
                <Space
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"/>
                <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                    android:id="@+id/clickDurationSliderView"
                    android:layout_width="@dimen/slider_width_phone"
                    android:layout_height="match_parent"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/clickDurationHelpIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_help"
                    android:tint="@color/white"
                    android:layout_weight="0"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/timeBetweenClickSettingsStack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/slider_height_phone">
                <TextView
                    android:textSize="@dimen/font_size_subtext_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/normal_touch_point_text2"/>
                <Space
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"/>
                <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                    android:id="@+id/clickIntervalSliderView"
                    android:layout_width="@dimen/slider_width_phone"
                    android:layout_height="match_parent"/>
                <Space
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/clickIntervalHelpIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_help"
                    android:tint="@color/white"
                    android:layout_weight="0"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</com.zjx.jyandroid.Extensions.pubg.componentsettingsview.ConditionalCrazyTapComponentSettingsView>
