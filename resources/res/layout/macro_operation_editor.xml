<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.Macro.MacroOperationEditor xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/jy_blue_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/navigationBar"
        android:background="@color/jy_blue_2"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/macro_operation_editor_text1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"/>
        <Button
            android:textColor="@color/white"
            android:id="@+id/finishButton"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/finish"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:id="@+id/sidePanelScrollView"
        android:background="@color/jy_blue_1"
        android:layout_width="140dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/sidePanelLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.Macro.MacroSideButton
                android:id="@+id/clickButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"/>
            <View
                android:id="@+id/view27"
                android:background="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="1px"/>
            <com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.Macro.MacroSideButton
                android:id="@+id/pressAndReleaseButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"/>
            <View
                android:id="@+id/view28"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.Macro.MacroSideButton
                android:id="@+id/swipeButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"/>
            <View
                android:id="@+id/view29"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.Macro.MacroSideButton
                android:id="@+id/sleepButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"/>
            <View
                android:id="@+id/view30"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.Macro.MacroSideButton
                android:id="@+id/triggerRcButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"/>
            <View
                android:id="@+id/view49"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/onlyWangzuoRelatedOperationsStack"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.Macro.MacroSideButton
                    android:id="@+id/resetViewButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"/>
                <View
                    android:id="@+id/view32"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.Macro.MacroSideButton
                    android:id="@+id/resetJoystickButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"/>
                <View
                    android:id="@+id/view31"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.Macro.MacroSideButton
                    android:id="@+id/moveJoystickButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"/>
                <View
                    android:id="@+id/view57"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <ScrollView
        android:background="@color/jy_blue_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/sidePanelScrollView"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar"
        app:layout_constraintVertical_bias="0">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/macroOperationViewsStack"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginRight="30dp"
            android:divider="@drawable/macro_operation_divider"
            android:showDividers="middle"/>
    </ScrollView>
    <View
        android:background="@color/white"
        android:layout_width="0dp"
        android:layout_height="1px"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar"/>
    <View
        android:background="@color/white"
        android:layout_width="1px"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sidePanelScrollView"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar"/>
</com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.Macro.MacroOperationEditor>
