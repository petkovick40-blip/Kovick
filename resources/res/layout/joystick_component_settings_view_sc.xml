<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.JoystickComponentSettingsViewSC xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/component_settings_view_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keymap_component_settings_intro_title"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="5dp"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:id="@+id/textView4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/joystick_settings_prompt"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:src="@drawable/white_dotted_line"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="@dimen/slider_width_phone"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/joystick_settings_text1"/>
                    <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                        android:id="@+id/horizontalSpeedSliderView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/slider_height_phone"
                        app:sliderAddValue="10"
                        app:sliderMinusValue="10"/>
                </LinearLayout>
                <Space
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="@dimen/slider_width_phone"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/joystick_settings_text2"/>
                    <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                        android:id="@+id/verticalSpeedSliderView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </LinearLayout>
                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/joystickPropertyHelpIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_help"
                    android:tint="@color/white"
                    android:layout_weight="0"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="@dimen/slider_width_phone"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/joystick_settings_text3"/>
                    <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                        android:id="@+id/zeroRadiusSliderView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/slider_height_phone"/>
                </LinearLayout>
                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:src="@drawable/white_dotted_line"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:text="@string/joystick_settings_text4"/>
                <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/switchRadiusModeSegmentedControl"
                    android:background="@color/settings_segmented_control_background"
                    android:layout_width="260dp"
                    android:layout_height="@dimen/button_height_phone"
                    android:elevation="0dp"
                    app:borderColor="@color/settings_segmented_control_background"
                    app:borderWidth="0dp"
                    app:divider="@color/settings_segmented_control_divider"
                    app:dividerPadding="5dp"
                    app:dividerWidth="1dp"
                    app:draggable="true"
                    app:position="0"
                    app:radius="5dp"
                    app:ripple="true"
                    app:rippleColor="@color/white"
                    app:selectedBackground="@color/white"
                    app:selectionAnimationDuration="200">
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/joystick_settings_text5"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_subtext_phone"/>
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/joystick_settings_text13"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_subtext_phone"/>
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:id="@+id/segmentedButton"
                        android:padding="7dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/joystick_settings_text6"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_subtext_phone"/>
                </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/switchRadiusTypeHelpIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_help"
                    android:tint="@color/white"
                    android:layout_weight="0"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/switchRadiusKeySettingsStack"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="0">
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:layout_width="85dp"
                        android:layout_height="match_parent"
                        android:text="@string/joystick_settings_text7"/>
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:id="@+id/mouseLockKeyTextView"
                        android:layout_width="65dp"
                        android:layout_height="match_parent"
                        android:text="@string/empty"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>
                    <Button
                        android:textSize="@dimen/font_size_text_phone"
                        android:textStyle="bold"
                        android:textColor="@color/component_settings_view_background"
                        android:id="@+id/changeMouseLockKeyButton"
                        android:background="@drawable/button_rounded_white"
                        android:layout_width="@dimen/button_width_phone"
                        android:layout_height="@dimen/button_height_phone"
                        android:text="@string/modify"/>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/switchRadiusRatioSettingsStack"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/slider_height_phone">
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:layout_width="120dp"
                        android:layout_height="match_parent"
                        android:text="@string/joystick_settings_text8"/>
                    <Space
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"/>
                    <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                        android:id="@+id/switchRadiusRatioSliderView"
                        android:layout_width="@dimen/slider_width_phone"
                        android:layout_height="match_parent"/>
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/imageView2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:src="@drawable/white_dotted_line"/>
            <Space
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:text="@string/joystick_settings_text9"/>
                <Space
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"/>
                <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/triggerJoystickModeSegmentedControl"
                    android:background="@color/settings_segmented_control_background"
                    android:layout_width="150dp"
                    android:layout_height="@dimen/button_height_phone"
                    android:elevation="0dp"
                    app:borderColor="@color/settings_segmented_control_background"
                    app:borderWidth="0dp"
                    app:divider="@color/settings_segmented_control_divider"
                    app:dividerPadding="5dp"
                    app:dividerWidth="1dp"
                    app:draggable="true"
                    app:position="0"
                    app:radius="5dp"
                    app:ripple="true"
                    app:rippleColor="@color/white"
                    app:selectedBackground="@color/white"
                    app:selectionAnimationDuration="200">
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/joystick_settings_text10"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_subtext_phone"/>
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/joystick_settings_text11"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_subtext_phone"/>
                </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/imageView3"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:src="@drawable/white_dotted_line"
                android:layout_weight="1"/>
            <Space
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/slider_height_phone">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:text="@string/joystick_settings_text12"/>
                <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                    android:id="@+id/joystickTotalMoveSliderView"
                    android:visibility="gone"
                    android:layout_width="@dimen/slider_width_phone"
                    android:layout_height="match_parent"/>
                <Space
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/totalMoveCountHelpIcon"
                    android:visibility="gone"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_help"
                    android:tint="@color/white"
                    android:layout_weight="0"/>
            </LinearLayout>
            <Space
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </ScrollView>
</com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.JoystickComponentSettingsViewSC>
