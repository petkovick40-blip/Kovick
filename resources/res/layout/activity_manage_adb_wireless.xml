<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/navigation_bar_background"
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/activity_manage_adb_wireless_text3"
                android:layout_weight="0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="@color/jy_blue_1"
                android:gravity="center"
                android:id="@+id/finishButton"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/finish"
                android:layout_weight="0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:background="#1a000000"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_weight="0"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/black"
                            android:gravity="center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginRight="80dp"
                            android:text="@string/manage_adb_activity_step1"/>
                        <Space
                            android:layout_width="5dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/developmentModeHelpIcon"
                            android:layout_width="15dp"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_help"
                            android:tint="@color/black"
                            android:layout_weight="0"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textColor="@color/white"
                        android:id="@+id/developmentModeButton"
                        android:background="@drawable/rounded_button_background_15dp"
                        android:layout_width="80dp"
                        android:layout_height="30dp"
                        android:text="@string/unknown"
                        android:backgroundTint="@color/jy_blue_1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/black"
                            android:gravity="center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginRight="80dp"
                            android:text="@string/manage_adb_activity_step2"/>
                        <Space
                            android:layout_width="5dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/adbEnableStatusHelpButton"
                            android:layout_width="15dp"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_help"
                            android:tint="@color/black"
                            android:layout_weight="0"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textColor="@color/white"
                        android:id="@+id/adbEnableStatusButton"
                        android:background="@drawable/rounded_button_background_15dp"
                        android:layout_width="80dp"
                        android:layout_height="30dp"
                        android:text="@string/unknown"
                        android:backgroundTint="@color/jy_blue_1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/turnOnWirelessDebuggingLayout"
                    android:layout_width="match_parent"
                    android:layout_height="50dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/black"
                                android:gravity="center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="80dp"
                                android:text="@string/activity_manage_adb_wireless_turn_on_wireless_debugging"/>
                            <Space
                                android:layout_width="5dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"/>
                            <ImageView
                                android:id="@+id/enableWirelessDebugginHelpIcon"
                                android:layout_width="15dp"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_help"
                                android:tint="@color/black"
                                android:layout_weight="0"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="9sp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginRight="100dp"
                            android:text="@string/activity_manage_adb_wireless_restart_wireless_debugging"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textColor="@color/white"
                        android:id="@+id/enableWirelessDebuggingButton"
                        android:background="@drawable/rounded_button_background_15dp"
                        android:layout_width="80dp"
                        android:layout_height="30dp"
                        android:text="@string/unknown"
                        android:backgroundTint="@color/jy_blue_1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:background="#1a000000"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_weight="0"/>
                <TextView
                    android:id="@+id/textView12"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/manage_adb_activity_step2_sub"/>
                <ImageView
                    android:id="@+id/imageView6"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    app:srcCompat="@drawable/adb_prompt"/>
                <View
                    android:id="@+id/view51"
                    android:background="#1a000000"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_weight="0"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/pairLayout"
                    android:layout_width="match_parent"
                    android:layout_height="70dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/black"
                                android:gravity="center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginRight="80dp"
                                android:text="@string/activity_manage_adb_wireless_text4"/>
                            <Space
                                android:layout_width="5dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"/>
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_help"
                                android:tint="@color/black"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="@dimen/font_size_text_phone"
                            android:textColor="@color/link_blue"
                            android:id="@+id/cancelPairButton"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:text="@string/activity_manage_adb_wireless_text2"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textColor="@color/white"
                        android:id="@+id/startPairingViewButton"
                        android:background="@drawable/rounded_button_background_15dp"
                        android:layout_width="80dp"
                        android:layout_height="30dp"
                        android:text="@string/unknown"
                        android:backgroundTint="@color/jy_blue_1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:background="#1a000000"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_weight="0"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/black"
                                android:gravity="center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginRight="80dp"
                                android:text="@string/activity_manage_adb_wireless_text6"/>
                            <Space
                                android:layout_width="5dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"/>
                            <ImageView
                                android:id="@+id/tcpPortStatusHelpIcon"
                                android:layout_width="15dp"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_help"
                                android:tint="@color/black"
                                android:layout_weight="1"/>
                        </LinearLayout>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textColor="@color/white"
                        android:id="@+id/tcpPortStatusButton"
                        android:background="@drawable/rounded_button_background_15dp"
                        android:layout_width="80dp"
                        android:layout_height="30dp"
                        android:text="@string/unknown"
                        android:backgroundTint="@color/jy_blue_1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:background="#1a000000"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_weight="0"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/black"
                                android:gravity="center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginRight="80dp"
                                android:text="@string/activity_manage_adb_wireless_text1"/>
                            <Space
                                android:layout_width="5dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"/>
                            <ImageView
                                android:id="@+id/waitForConnectionHelpIcon"
                                android:layout_width="15dp"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_help"
                                android:tint="@color/black"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="9sp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginRight="100dp"
                            android:text="@string/activity_manage_adb_wireless_try_revoke_authorization"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textColor="@color/white"
                        android:id="@+id/connectionStatusButton"
                        android:background="@drawable/rounded_button_background_15dp"
                        android:layout_width="80dp"
                        android:layout_height="30dp"
                        android:text="@string/unknown"
                        android:backgroundTint="@color/jy_blue_1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:id="@+id/view11"
                    android:background="#1a000000"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_weight="0"/>
                <TextView
                    android:textSize="12sp"
                    android:gravity="right"
                    android:id="@+id/seeSolutionTextView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/manage_adb_activity_solution"/>
                <TextView
                    android:textSize="15sp"
                    android:gravity="right"
                    android:id="@+id/watchTutorialButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/manage_adb_activity_redirect_to_tutorial"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
