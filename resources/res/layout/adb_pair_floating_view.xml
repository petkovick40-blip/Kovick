<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.ADB.ADBPairFloatingView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/containerView"
        android:background="@color/jy_blue_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/jy_blue_1"
        app:cardCornerRadius="3dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <EditText
                    android:textSize="@dimen/font_size_subtext_phone"
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:id="@+id/passcodeEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/adb_pair_floating_view_text1"
                    android:ems="5"
                    android:shadowColor="@color/white"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:backgroundTint="@color/white"/>
                <EditText
                    android:textSize="@dimen/font_size_subtext_phone"
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:id="@+id/portEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/adb_pair_floating_view_text2"
                    android:ems="5"
                    android:shadowColor="@color/white"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:backgroundTint="@color/white"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/keyboardView"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:divider="@drawable/adb_pair_floating_view_keyboard_divider"
                android:showDividers="middle"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@drawable/adb_pair_floating_view_keyboard_divider"
                    android:layout_weight="1"
                    android:showDividers="middle">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/numberButton1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/font_size_subtext_phone"
                            android:gravity="center"
                            android:id="@+id/textView24"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="1"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/numberButton2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/font_size_subtext_phone"
                            android:gravity="center"
                            android:id="@+id/textView25"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="2"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/numberButton3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/font_size_subtext_phone"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="3"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@drawable/adb_pair_floating_view_keyboard_divider"
                    android:layout_weight="1"
                    android:showDividers="middle">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/numberButton4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/font_size_subtext_phone"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="4"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/numberButton5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/font_size_subtext_phone"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="5"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/numberButton6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/font_size_subtext_phone"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="6"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@drawable/adb_pair_floating_view_keyboard_divider"
                    android:layout_weight="1"
                    android:showDividers="middle">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/numberButton7"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/font_size_subtext_phone"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="7"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/numberButton8"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/font_size_subtext_phone"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="8"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/numberButton9"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/font_size_subtext_phone"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="9"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@drawable/adb_pair_floating_view_keyboard_divider"
                    android:layout_weight="1"
                    android:showDividers="middle">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/font_size_subtext_phone"
                            android:gravity="center"
                            android:id="@+id/clearButton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/clear"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/numberButton0"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/font_size_subtext_phone"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="0"/>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:visibility="invisible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/font_size_subtext_phone"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/adb_pair_floating_view_text3"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingRight="2dp"
                android:paddingBottom="2dp"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:divider="@drawable/adb_pair_floating_view_keyboard_divider"
                android:showDividers="middle"
                android:paddingStart="2dp">
                <androidx.cardview.widget.CardView
                    android:id="@+id/activateButton"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/font_size_subtext_phone"
                        android:gravity="center"
                        android:id="@+id/activateTextView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/adb_pair_floating_view_text3"/>
                    <ProgressBar
                        android:id="@+id/progressLoader"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:indeterminateTint="@color/jy_blue_1"
                        style="?android:attr/progressBarStyle"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/tutorialView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/imageView13"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:srcCompat="@drawable/app_logo_1024"/>
                <ImageView
                    android:id="@+id/imageView14"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    app:srcCompat="@drawable/app_logo_1024"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</com.zjx.jyandroid.ADB.ADBPairFloatingView>
