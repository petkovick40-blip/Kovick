<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.ForegroundService.UI.BasicSettingsViewSC xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:background="@color/jy_blue_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/font_size_subtext_phone"
                    android:textColor="@color/jy_blue_1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/basic_settings_view_sc_text1"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.zjx.jyandroid.base.Components.TextWithSwitchView
                    android:id="@+id/switchPointerLocationDisplayCell"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    app:showSubtitle="false"
                    app:titleSize="@dimen/font_size_text_phone"
                    app:titleText="@string/basic_settings_view_sc_text2"
                    app:titleTextColor="#ffffffff"/>
                <View
                    android:id="@+id/view52"
                    android:background="#6affffff"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_weight="1"/>
                <com.zjx.jyandroid.base.Components.TextWithSwitchView
                    android:id="@+id/enableSCPointCell"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    app:showSubtitle="false"
                    app:titleSize="@dimen/font_size_text_phone"
                    app:titleText="@string/basic_settings_view_sc_text3"
                    app:titleTextColor="#ffffffff"/>
                <View
                    android:id="@+id/view46"
                    android:background="#6affffff"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <com.zjx.jyandroid.base.Components.TextWithSliderView
                    android:id="@+id/scPointDashLengthCell"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    app:showSubtitle="false"
                    app:sliderMax="20"
                    app:sliderMin="0"
                    app:titleSize="@dimen/font_size_text_phone"
                    app:titleText="@string/basic_settings_view_sc_text4"
                    app:titleTextColor="@color/white"/>
                <View
                    android:id="@+id/view47"
                    android:background="#6affffff"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <com.zjx.jyandroid.base.Components.TextWithSliderView
                    android:id="@+id/scPointDashGapCell"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    app:showSubtitle="false"
                    app:sliderMax="20"
                    app:sliderMin="0"
                    app:titleSize="@dimen/font_size_text_phone"
                    app:titleText="@string/basic_settings_view_sc_text5"
                    app:titleTextColor="@color/white"/>
                <View
                    android:id="@+id/view48"
                    android:background="#6affffff"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <com.zjx.jyandroid.base.Components.TextWithSliderView
                    android:id="@+id/scPointDashWidthCell"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    app:showSubtitle="false"
                    app:sliderMax="8"
                    app:sliderMin="0"
                    app:titleSize="@dimen/font_size_text_phone"
                    app:titleText="@string/basic_settings_view_sc_text6"
                    app:titleTextColor="@color/white"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.zjx.jyandroid.ForegroundService.UI.BasicSettingsViewSC>
