<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.ForegroundService.UI.SelectKeymapModule.SelectKeymapContainerView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.Jyandroid"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/jy_blue_2"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:weightSum="100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="98"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/createKeymapTextView"
            android:background="@android:color/transparent"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:text="@string/select_keymap_container_view_new"
            android:layout_weight="0"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/importKeymapTextView"
            android:background="@android:color/transparent"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:text="@string/select_keymap_container_view_import"
            android:layout_weight="0"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/doneTextView"
            android:background="@android:color/transparent"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:text="@string/finish"
            android:layout_weight="0"/>
        <Space
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linearLayout"
        android:background="@color/jy_blue_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="40dp"
        android:weightSum="100"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/sidePanelLayout"
            android:background="@color/jy_blue_1"
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:layout_weight="0">
            <Button
                android:textSize="13sp"
                android:textColor="@color/white"
                android:id="@+id/officialKeymapButton"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/select_keymap_container_view_official_config"
                android:fontFamily="sans-serif"/>
            <View
                android:id="@+id/view45"
                android:background="#ffffffff"
                android:layout_width="match_parent"
                android:layout_height="3px"/>
            <Button
                android:textSize="13sp"
                android:textColor="@color/white"
                android:id="@+id/customKeymapButton"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/select_keymap_container_view_my_config"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
        <com.evrencoskun.tableview.TableView
            android:id="@+id/tableViewContainer"
            android:paddingBottom="30dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:allow_click_inside_cell="true"
            app:column_header_height="0dp"
            app:row_header_width="0dp"
            app:selected_color="#ff6a73ff"
            app:separator_color="#3affffff"
            app:show_horizontal_separator="false"
            app:show_vertical_separator="true"
            app:unselected_color="@color/transparent"/>
    </LinearLayout>
</com.zjx.jyandroid.ForegroundService.UI.SelectKeymapModule.SelectKeymapContainerView>
