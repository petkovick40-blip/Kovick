<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/level1"
        android:layout_width="13dp"
        android:layout_height="16dp"
        android:src="@drawable/account_level_icon1"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/level1_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/level1_progress"
        android:background="@drawable/account_level_progress"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_margin="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/level1"
        app:layout_constraintEnd_toStartOf="@+id/level2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/level1"
        app:layout_constraintTop_toTopOf="@+id/level1"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/white"
        android:id="@+id/level1_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/level1"
        app:layout_constraintStart_toStartOf="@+id/level1"
        app:layout_constraintTop_toBottomOf="@+id/level1"/>
    <ImageView
        android:id="@+id/level2"
        android:layout_width="13dp"
        android:layout_height="16dp"
        android:src="@drawable/account_level_icon2"
        app:layout_constraintEnd_toStartOf="@+id/level2_progress"
        app:layout_constraintStart_toEndOf="@+id/level1_progress"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/level2_progress"
        android:background="@drawable/account_level_progress"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_margin="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/level2"
        app:layout_constraintEnd_toStartOf="@+id/level3"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/level2"
        app:layout_constraintTop_toTopOf="@+id/level2"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/white"
        android:id="@+id/level2_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/level2"
        app:layout_constraintStart_toStartOf="@+id/level2"
        app:layout_constraintTop_toBottomOf="@+id/level1"/>
    <ImageView
        android:id="@+id/level3"
        android:layout_width="13dp"
        android:layout_height="16dp"
        android:src="@drawable/account_level_icon3"
        app:layout_constraintEnd_toStartOf="@+id/level3_progress"
        app:layout_constraintStart_toEndOf="@+id/level2_progress"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/level3_progress"
        android:background="@drawable/account_level_progress"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_margin="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/level3"
        app:layout_constraintEnd_toStartOf="@+id/level4"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/level3"
        app:layout_constraintTop_toTopOf="@+id/level3"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/white"
        android:id="@+id/level3_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/level3"
        app:layout_constraintStart_toStartOf="@+id/level3"
        app:layout_constraintTop_toBottomOf="@+id/level3"/>
    <ImageView
        android:id="@+id/level4"
        android:layout_width="13dp"
        android:layout_height="16dp"
        android:src="@drawable/account_level_icon4"
        app:layout_constraintEnd_toStartOf="@+id/level4_progress"
        app:layout_constraintStart_toEndOf="@+id/level3_progress"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/white"
        android:id="@+id/level4_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/level4"
        app:layout_constraintStart_toStartOf="@+id/level4"
        app:layout_constraintTop_toBottomOf="@+id/level4"/>
    <View
        android:id="@+id/level4_progress"
        android:background="@drawable/account_level_progress"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_margin="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/level4"
        app:layout_constraintEnd_toStartOf="@+id/level5"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/level4"
        app:layout_constraintTop_toTopOf="@+id/level4"/>
    <ImageView
        android:id="@+id/level5"
        android:layout_width="13dp"
        android:layout_height="16dp"
        android:src="@drawable/account_level_icon5"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/level4_progress"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/white"
        android:id="@+id/level5_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/level5"
        app:layout_constraintStart_toStartOf="@+id/level5"
        app:layout_constraintTop_toBottomOf="@+id/level5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
