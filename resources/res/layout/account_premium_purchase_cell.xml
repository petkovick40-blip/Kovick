<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/account_premium_purchase_cell_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/account_primary_color"
        android:gravity="center"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="Three Month Premium"
        android:lines="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/account_primary_color"
        android:gravity="center"
        android:id="@+id/price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        android:text="HK$8.99"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time"/>
    <View
        android:id="@+id/points_cell_background"
        android:background="@drawable/account_premium_purchase_cell_points_background"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="-4dp"
        app:layout_constraintEnd_toEndOf="@+id/reward_experience_value"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/points_image"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/ic_account_growth_value"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/points_cell_background"
        app:layout_constraintStart_toStartOf="@+id/points_cell_background"
        app:layout_constraintTop_toTopOf="@+id/points_cell_background"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ffe0a000"
        android:id="@+id/reward_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+20"
        app:layout_constraintBottom_toBottomOf="@+id/points_image"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/points_image"
        app:layout_constraintTop_toTopOf="@+id/points_image"/>
    <ImageView
        android:id="@+id/experience_value_image"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/ic_account_experience"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/points_cell_background"
        app:layout_constraintStart_toEndOf="@+id/reward_points"
        app:layout_constraintTop_toTopOf="@+id/points_cell_background"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ff16c5ef"
        android:id="@+id/reward_experience_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+20"
        app:layout_constraintBottom_toBottomOf="@+id/points_image"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/experience_value_image"
        app:layout_constraintTop_toTopOf="@+id/points_image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
