<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@color/navigation_bar_background"
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/manage_permission_activity_title"
                    android:layout_weight="0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textColor="@color/jy_blue_1"
                    android:gravity="center"
                    android:id="@+id/finishButton"
                    android:paddingRight="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/finish"
                    android:layout_weight="0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:id="@+id/textView5"
                android:paddingLeft="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/manage_permission_activity_subtitle1"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/manage_permission_activity_text1"/>
                        <Space
                            android:layout_width="5dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/floatingPermissionHelpIcon"
                            android:layout_width="15dp"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_help"
                            android:tint="@color/black"
                            android:layout_weight="0"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textColor="@color/white"
                        android:id="@+id/floatingViewPermissionButton"
                        android:background="@drawable/rounded_button_background_15dp"
                        android:layout_width="80dp"
                        android:layout_height="30dp"
                        android:text="@string/unknown"
                        android:backgroundTint="@color/jy_blue_1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:id="@+id/view8"
                    android:background="#1a000000"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_weight="0"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/manageFileRWPermssionRow"
                    android:layout_width="match_parent"
                    android:layout_height="50dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/manage_permission_activity_text2"/>
                        <Space
                            android:layout_width="5dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/fileRWPermissionHelpIcon"
                            android:layout_width="15dp"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_help"
                            android:tint="@color/black"
                            android:layout_weight="0"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textColor="@color/white"
                        android:id="@+id/fileRWPermissionButton"
                        android:background="@drawable/rounded_button_background_15dp"
                        android:layout_width="80dp"
                        android:layout_height="30dp"
                        android:text="@string/unknown"
                        android:backgroundTint="@color/jy_blue_1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:id="@+id/view9"
                    android:background="#1a000000"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_weight="0"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="50dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/manage_permission_activity_text3"/>
                        <Space
                            android:layout_width="5dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/usagePermissionHelpIcon"
                            android:layout_width="15dp"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_help"
                            android:tint="@color/black"
                            android:layout_weight="0"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textColor="@color/white"
                        android:id="@+id/usagePermissionButton"
                        android:background="@drawable/rounded_button_background_15dp"
                        android:layout_width="80dp"
                        android:layout_height="30dp"
                        android:text="@string/unknown"
                        android:backgroundTint="@color/jy_blue_1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:id="@+id/view10"
                    android:background="#1a000000"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_weight="0"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/activity_manage_permission_text1"/>
                        <Space
                            android:layout_width="5dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/allowBackgroundPermissionHelpIcon"
                            android:layout_width="15dp"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_help"
                            android:tint="@color/black"
                            android:layout_weight="0"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textColor="@color/white"
                        android:id="@+id/allowBackgroundPermissionButton"
                        android:background="@drawable/rounded_button_background_15dp"
                        android:layout_width="80dp"
                        android:layout_height="30dp"
                        android:text="@string/unknown"
                        android:backgroundTint="@color/jy_blue_1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/textView8"
                android:paddingLeft="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/manage_permission_activity_subtitle2"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_weight="0">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/manage_permission_activity_text4"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textColor="@color/white"
                        android:id="@+id/powerSaverButton"
                        android:background="@drawable/rounded_button_background_15dp"
                        android:layout_width="80dp"
                        android:layout_height="30dp"
                        android:text="@string/manage_permission_activity_go_turn_off"
                        android:backgroundTint="@color/jy_blue_1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:background="#1a000000"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_weight="0"/>
            </LinearLayout>
            <View
                android:id="@+id/view44"
                android:background="#1a000000"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_weight="0"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/shoucuoPermissions"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:id="@+id/textView14"
                    android:paddingLeft="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_manage_permission_text2"
                    android:layout_weight="0"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="0">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:text="@string/activity_manage_permission_text3"/>
                            <Space
                                android:layout_width="5dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"/>
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_help"
                                android:tint="@color/black"
                                android:layout_weight="0"/>
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatButton
                            android:textColor="@color/white"
                            android:id="@+id/locationPermissionButton"
                            android:background="@drawable/rounded_button_background_15dp"
                            android:layout_width="80dp"
                            android:layout_height="30dp"
                            android:text="@string/unknown"
                            android:backgroundTint="@color/jy_blue_1"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <View
                        android:background="#1a000000"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_weight="0"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:text="@string/activity_manage_permission_text4"/>
                            <Space
                                android:layout_width="5dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"/>
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_help"
                                android:tint="@color/black"
                                android:layout_weight="0"/>
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatButton
                            android:textColor="@color/white"
                            android:id="@+id/bluetoothScanPermissionButton"
                            android:background="@drawable/rounded_button_background_15dp"
                            android:layout_width="80dp"
                            android:layout_height="30dp"
                            android:text="@string/unknown"
                            android:backgroundTint="@color/jy_blue_1"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <View
                        android:background="#1a000000"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_weight="0"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:text="@string/activity_manage_permission_text5"/>
                            <Space
                                android:layout_width="5dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"/>
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_help"
                                android:tint="@color/black"
                                android:layout_weight="0"/>
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatButton
                            android:textColor="@color/white"
                            android:id="@+id/bluetoothConnectPermissionButton"
                            android:background="@drawable/rounded_button_background_15dp"
                            android:layout_width="80dp"
                            android:layout_height="30dp"
                            android:text="@string/unknown"
                            android:backgroundTint="@color/jy_blue_1"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
