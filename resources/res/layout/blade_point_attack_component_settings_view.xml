<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.plugin.bladepoint.componentsettingsview.BladePointAttackComponentSettingsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/jy_blue_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keymap_component_settings_intro_title"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="5dp"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:id="@+id/textView4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="在下方绑定键位后，可实现四项攻击键的使用。按下鼠标左键后，按绑定的键即可实现上下左右滑动攻击"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:src="@drawable/white_dotted_line"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="绑定按键 - 上"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/northKeyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="25dp"
                    android:text="@string/empty"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="wrap_content"/>
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textStyle="bold"
                    android:textColor="@color/component_settings_view_background"
                    android:id="@+id/changeNorthHotkeyButton"
                    android:background="@drawable/button_rounded_white"
                    android:layout_width="@dimen/button_width_phone"
                    android:layout_height="@dimen/button_height_phone"
                    android:text="@string/modify"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="绑定按键 - 下"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/southKeyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="25dp"
                    android:text="@string/empty"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="wrap_content"/>
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textStyle="bold"
                    android:textColor="@color/component_settings_view_background"
                    android:id="@+id/changeSouthHotkeyButton"
                    android:background="@drawable/button_rounded_white"
                    android:layout_width="@dimen/button_width_phone"
                    android:layout_height="@dimen/button_height_phone"
                    android:text="@string/modify"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="绑定按键 - 左"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/westKeyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="25dp"
                    android:text="@string/empty"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="wrap_content"/>
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textStyle="bold"
                    android:textColor="@color/component_settings_view_background"
                    android:id="@+id/changeWestHotkeyButton"
                    android:background="@drawable/button_rounded_white"
                    android:layout_width="@dimen/button_width_phone"
                    android:layout_height="@dimen/button_height_phone"
                    android:text="@string/modify"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="绑定按键 - 右"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/eastKeyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="25dp"
                    android:text="@string/empty"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="wrap_content"/>
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textStyle="bold"
                    android:textColor="@color/component_settings_view_background"
                    android:id="@+id/changeEastHotkeyButton"
                    android:background="@drawable/button_rounded_white"
                    android:layout_width="@dimen/button_width_phone"
                    android:layout_height="@dimen/button_height_phone"
                    android:text="@string/modify"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.zjx.jyandroid.plugin.bladepoint.componentsettingsview.BladePointAttackComponentSettingsView>
