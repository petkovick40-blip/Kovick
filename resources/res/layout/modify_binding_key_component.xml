<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/font_size_text_phone"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="@dimen/font_size_text_phone"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/bindingKeyTextView"
        android:layout_width="50dp"
        android:layout_height="match_parent"/>
    <Button
        android:textColor="@color/component_settings_view_background"
        android:id="@+id/changeKeyButton"
        android:background="@drawable/button_rounded_white"
        android:layout_width="@dimen/button_width_phone"
        android:layout_height="@dimen/button_height_phone"
        android:text="@string/modify"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
</LinearLayout>
