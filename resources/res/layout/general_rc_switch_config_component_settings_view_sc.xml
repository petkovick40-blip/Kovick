<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.Extensions.GeneralRC.ComponentSettingsView.GeneralRCSwitchConfigComponentSettingsViewSC xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/component_settings_view_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keymap_component_settings_intro_title"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="可设置到切换至某个通用压枪配置"/>
        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp"/>
        <ImageView
            android:id="@+id/imageView9"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:src="@drawable/white_dotted_line"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/blockTouchLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="25dp">
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:layout_width="65dp"
                android:layout_height="match_parent"
                android:text="@string/block_touch"/>
            <Switch
                android:id="@+id/blockTouchSwitch"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:thumbTint="@drawable/switch_thumb"
                android:trackTint="@drawable/switch_track"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="25dp">
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="配置切换"/>
            <Space
                android:layout_width="30dp"
                android:layout_height="wrap_content"/>
            <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                android:id="@+id/switchIndexSliderView"
                android:layout_width="250dp"
                android:layout_height="match_parent"
                app:sliderMax="10"
                app:sliderMin="1"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/helpIcon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_help"
                android:tint="@color/white"
                android:layout_weight="0"/>
        </LinearLayout>
    </LinearLayout>
</com.zjx.jyandroid.Extensions.GeneralRC.ComponentSettingsView.GeneralRCSwitchConfigComponentSettingsViewSC>
