<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.plugin.deviceinfoplugin.DeviceInfoFloatingPanel xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="#70000000"
        app:cardCornerRadius="5dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/containerView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:backgroundTint="@color/transparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <Space
                android:layout_width="5dp"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/latencyLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="right"
                    android:layout_width="10dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_wifi_router"
                    android:tint="@color/white"/>
                <TextView
                    android:textSize="7sp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/latencyTextView"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:text="   -   "
                    android:includeFontPadding="false"/>
                <Space
                    android:layout_width="3dp"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/cpuTemperatureLayout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="right"
                    android:layout_width="10dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/cpu_temperature"
                    android:tint="@color/white"/>
                <TextView
                    android:textSize="7sp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/cpuTemperatureTextView"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:text="   -   "
                    android:includeFontPadding="false"/>
                <Space
                    android:layout_width="3dp"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/timeLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="right"
                    android:layout_width="10dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_clock"
                    android:tint="@color/white"/>
                <TextView
                    android:textSize="7sp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/timeTextView"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:text="   -   "
                    android:includeFontPadding="false"/>
                <Space
                    android:layout_width="3dp"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/fpsLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="right"
                    android:layout_width="10dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_share_screen"
                    android:tint="@color/white"/>
                <TextView
                    android:textSize="7sp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/fpsTextView"
                    android:paddingLeft="3dp"
                    android:paddingRight="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:text="  -  "
                    android:includeFontPadding="false"/>
                <Space
                    android:layout_width="3dp"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/networkLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="right"
                    android:layout_width="10dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_wifi"
                    android:tint="@color/white"/>
                <TextView
                    android:textSize="7sp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/internetTextView"
                    android:paddingLeft="3dp"
                    android:paddingRight="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:text="   -    "
                    android:includeFontPadding="false"/>
                <Space
                    android:layout_width="3dp"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/batteryLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="right"
                    android:layout_width="10dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_battery"
                    android:tint="@color/white"/>
                <TextView
                    android:textSize="7sp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/batteryTextView"
                    android:paddingLeft="3dp"
                    android:paddingRight="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:text="  -  "
                    android:includeFontPadding="false"/>
                <Space
                    android:layout_width="3dp"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/timeElapsedLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="right"
                    android:layout_width="10dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_timer"
                    android:tint="@color/white"/>
                <TextView
                    android:textSize="7sp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/playTimeTextView"
                    android:paddingLeft="3dp"
                    android:paddingRight="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:text="  -  "
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</com.zjx.jyandroid.plugin.deviceinfoplugin.DeviceInfoFloatingPanel>
