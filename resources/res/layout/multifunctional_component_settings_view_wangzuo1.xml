<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.MultifunctionalSettingsViewWangzuo xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/view34"
            android:background="@color/white"
            android:layout_width="1px"
            android:layout_height="match_parent"/>
        <ScrollView
            android:background="@color/jy_blue_1"
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:layout_weight="0">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sidePanelLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:id="@+id/switchFloatingBallDisplayButton"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/multifunctional_settings_switch_floating_ball_display"
                    android:fontFamily="sans-serif"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:id="@+id/switchRCPanelDisplayButton"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/multifunctional_settings_switch_rc_panel_display"
                    android:fontFamily="sans-serif"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:id="@+id/adjustRCValueButton"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/multifunctional_settings_adjust_rc_value"
                    android:fontFamily="sans-serif"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:id="@+id/horizontalRecoilControlButton"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/multifunctional_component_settings_view_wangzuo_text1"
                    android:fontFamily="sans-serif"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:id="@+id/longPressCrouchButton"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/multifunctional_settings_long_press_crouch"
                    android:fontFamily="sans-serif"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:id="@+id/cancelHouyaoButton"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/multifunctional_settings_anti_slow_move"
                    android:fontFamily="sans-serif"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
        </ScrollView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/componentSettingsView"
            android:background="@color/component_settings_view_background"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:paddingStart="8dp"/>
    </LinearLayout>
</com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.MultifunctionalSettingsViewWangzuo>
