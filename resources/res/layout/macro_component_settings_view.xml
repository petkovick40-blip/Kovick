<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.module.keymapeditor.componentsettingsview.MacroComponentSettingsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/jy_blue_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keymap_component_settings_intro_title"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="5dp"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:id="@+id/textView4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_settings_prompt"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:src="@drawable/white_dotted_line"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/macro_settings_text1"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/nameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/empty"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="wrap_content"/>
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textStyle="bold"
                    android:textColor="@color/component_settings_view_background"
                    android:id="@+id/changeNameButton"
                    android:background="@drawable/button_rounded_white"
                    android:layout_width="@dimen/button_width_phone"
                    android:layout_height="@dimen/button_height_phone"
                    android:text="@string/modify"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/macro_settings_text2"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/triggerKeyTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="25dp"
                    android:text="@string/empty"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="wrap_content"/>
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textStyle="bold"
                    android:textColor="@color/component_settings_view_background"
                    android:id="@+id/changeTriggerKeyButton"
                    android:background="@drawable/button_rounded_white"
                    android:layout_width="@dimen/button_width_phone"
                    android:layout_height="@dimen/button_height_phone"
                    android:text="@string/modify"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/macro_settings_text3"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/terminateKeyTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="25dp"
                    android:text="@string/empty"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="wrap_content"/>
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textStyle="bold"
                    android:textColor="@color/component_settings_view_background"
                    android:id="@+id/changeTerminateKeyButton"
                    android:background="@drawable/button_rounded_white"
                    android:layout_width="@dimen/button_width_phone"
                    android:layout_height="@dimen/button_height_phone"
                    android:text="@string/modify"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/macro_settings_text4"/>
                <Space
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"/>
                <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/triggerModeSegmentedControl"
                    android:background="@color/settings_segmented_control_background"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height_phone"
                    android:elevation="0dp"
                    app:borderColor="@color/settings_segmented_control_background"
                    app:borderWidth="0dp"
                    app:divider="@color/settings_segmented_control_divider"
                    app:dividerPadding="5dp"
                    app:dividerWidth="1dp"
                    app:draggable="true"
                    app:position="0"
                    app:radius="5dp"
                    app:ripple="true"
                    app:rippleColor="@color/white"
                    app:selectedBackground="@color/white"
                    app:selectionAnimationDuration="200">
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/macro_settings_text5"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_subtext_phone"/>
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/macro_settings_text6"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_subtext_phone"/>
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:id="@+id/segmentedButton"
                        android:padding="7dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/macro_settings_text7"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_subtext_phone"/>
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:id="@+id/segmentedButton4"
                        android:padding="7dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/macro_settings_text12"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_subtext_phone"/>
                </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:src="@drawable/white_dotted_line"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="0">
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/macro_settings_text8"/>
                    <Space
                        android:layout_width="10dp"
                        android:layout_height="match_parent"/>
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <Button
                            android:textSize="@dimen/font_size_text_phone"
                            android:textStyle="bold"
                            android:textColor="@color/component_settings_view_background"
                            android:id="@+id/editButton"
                            android:background="@drawable/button_rounded_white"
                            android:layout_width="@dimen/button_width_phone"
                            android:layout_height="@dimen/button_height_phone"
                            android:text="@string/macro_settings_text9"/>
                        <Space
                            android:layout_width="10dp"
                            android:layout_height="wrap_content"/>
                        <Button
                            android:textSize="@dimen/font_size_text_phone"
                            android:textStyle="bold"
                            android:textColor="@color/component_settings_view_background"
                            android:id="@+id/shareButton"
                            android:background="@drawable/button_rounded_white"
                            android:layout_width="@dimen/button_width_phone"
                            android:layout_height="@dimen/button_height_phone"
                            android:text="@string/macro_settings_text10"
                            android:layout_weight="1"/>
                        <Space
                            android:layout_width="10dp"
                            android:layout_height="wrap_content"/>
                        <Button
                            android:textSize="@dimen/font_size_text_phone"
                            android:textStyle="bold"
                            android:textColor="@color/component_settings_view_background"
                            android:id="@+id/applyButton"
                            android:background="@drawable/button_rounded_white"
                            android:layout_width="@dimen/button_width_phone"
                            android:layout_height="@dimen/button_height_phone"
                            android:text="@string/macro_settings_text11"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_weight="0"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.zjx.jyandroid.module.keymapeditor.componentsettingsview.MacroComponentSettingsView>
