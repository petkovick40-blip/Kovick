<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.Extensions.GeneralRC.AdjustRCValueBaseView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#6a000000"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_weight="0">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:gravity="start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/general_rc_adjust_rc_value_view_value_text"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:gravity="start"
                    android:id="@+id/resetButton"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:text="@string/reset"/>
            </LinearLayout>
            <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                android:id="@+id/slider"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/crazyTapSettingsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Switch
                android:textSize="10sp"
                android:textColor="@color/white"
                android:id="@+id/enableCrazyTapSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/general_rc_adjust_rc_value_view_enable_crazy_tap_switch_text"
                android:thumbTint="@drawable/switch_thumb"
                android:trackTint="@drawable/settings_switch_track_jy_blue"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/speedSettingsContainer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:id="@+id/textView40"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/general_rc_adjust_rc_value_view_crazy_tap_settings_header"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="30dp">
                    <TextView
                        android:textSize="8sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/general_rc_adjust_rc_value_view_crazy_tap_interval_text"/>
                    <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                        android:id="@+id/intervalSlider"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:sliderMax="1000"
                        app:sliderMin="10"/>
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="5dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="30dp">
                    <TextView
                        android:textSize="8sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/general_rc_adjust_rc_value_view_crazy_tap_duration_text"/>
                    <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                        android:id="@+id/durationSlider"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:sliderMax="1000"
                        app:sliderMin="10"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="8sp"
            android:textColor="@color/white"
            android:id="@+id/textView34"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/adjust_rc_value_panel_adjust_shortcut_prompt"
            android:layout_weight="0"/>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_weight="0">
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <Button
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:id="@+id/dynamicRCButton"
                android:background="@drawable/rounded_button_background_5dp"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:text="@string/adjust_rc_value_base_view_text2"
                android:layout_weight="0"
                android:backgroundTint="@color/jy_blue_1"/>
            <Space
                android:layout_width="5dp"
                android:layout_height="wrap_content"/>
            <Button
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:id="@+id/deleteButton"
                android:background="@drawable/rounded_button_background_5dp"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:text="@string/adjust_rc_value_base_view_text4"
                android:backgroundTint="@color/danger_red"/>
            <Space
                android:layout_width="5dp"
                android:layout_height="wrap_content"/>
            <Button
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:id="@+id/renameButton"
                android:background="@drawable/rounded_button_background_5dp"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:text="@string/rename"
                android:backgroundTint="@color/jy_blue_1"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/watchTutorialButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/general_rc_tutorial_button_text"/>
    </LinearLayout>
</com.zjx.jyandroid.Extensions.GeneralRC.AdjustRCValueBaseView>
