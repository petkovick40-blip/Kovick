<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/points_background"
        android:background="@drawable/account_page_card_background"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:backgroundTint="#262b6eff"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/points_image"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/account_product_points_image"
        android:layout_marginStart="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/points_background"
        app:layout_constraintStart_toStartOf="@+id/points_background"
        app:layout_constraintTop_toTopOf="@+id/points_background"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="#ff2b6eff"
        android:id="@+id/account_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="您的积分：340分"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/points_background"
        app:layout_constraintStart_toEndOf="@+id/points_image"
        app:layout_constraintTop_toTopOf="@+id/points_background"/>
    <ImageView
        android:id="@+id/product_image"
        android:layout_width="189dp"
        android:layout_height="189dp"
        android:layout_marginTop="28dp"
        android:src="@drawable/account_shopping_mall_image_default"
        app:layout_constraintEnd_toEndOf="@+id/points_background"
        app:layout_constraintStart_toStartOf="@+id/points_background"
        app:layout_constraintTop_toBottomOf="@+id/points_background"/>
    <ImageView
        android:id="@+id/level_image_bg"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="11dp"
        android:src="@drawable/ic_account_product_level_bg"
        android:layout_marginEnd="28dp"
        app:layout_constraintEnd_toEndOf="@+id/points_background"
        app:layout_constraintTop_toBottomOf="@+id/points_background"/>
    <ImageView
        android:id="@+id/level_image"
        android:layout_width="12.5dp"
        android:layout_height="15dp"
        android:src="@drawable/account_level_icon1"
        app:layout_constraintBottom_toBottomOf="@+id/level_image_bg"
        app:layout_constraintEnd_toEndOf="@+id/level_image_bg"
        app:layout_constraintStart_toStartOf="@+id/level_image_bg"
        app:layout_constraintTop_toTopOf="@+id/level_image_bg"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ff2b6eff"
        android:id="@+id/level_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="白银专属"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/level_image_bg"
        app:layout_constraintStart_toStartOf="@+id/level_image_bg"
        app:layout_constraintTop_toBottomOf="@+id/level_image_bg"/>
    <View
        android:id="@+id/product_detail_bg"
        android:background="@drawable/account_page_card_background"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="47dp"
        android:layout_marginBottom="-10dp"
        app:layout_constraintBottom_toBottomOf="@+id/redeem_count"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/product_image"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="#ff2b6eff"
        android:id="@+id/product_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="50积分"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/product_detail_bg"
        app:layout_constraintTop_toTopOf="@+id/product_detail_bg"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/account_primary_color"
        android:id="@+id/product_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="商品名称商品名称"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@+id/product_points"
        app:layout_constraintTop_toBottomOf="@+id/product_points"/>
    <View
        android:background="#ffe7e7e7"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/product_points"
        app:layout_constraintTop_toBottomOf="@+id/product_name"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ff828181"
        android:id="@+id/redeem_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="已有34人兑换"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@+id/product_points"
        app:layout_constraintTop_toBottomOf="@+id/product_name"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ff828181"
        android:id="@+id/limit_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="每日限购：2"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/account_card_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/redeem_count"/>
    <View
        android:id="@+id/product_privileges_bg"
        android:background="@drawable/account_page_card_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="-16dp"
        app:layout_constraintBottom_toBottomOf="@+id/product_privileges_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/product_detail_bg"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/account_primary_color"
        android:id="@+id/product_privileges_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/account_product_detail_privileges_title"
        android:maxLines="1"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/product_detail_bg"
        app:layout_constraintTop_toTopOf="@+id/product_privileges_bg"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ff828181"
        android:id="@+id/product_privileges_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="使用规则：使用规则使用规则使用规则使用规则使用规则使用规则使 使用规则使用规则使用规则使用规则使用规则使用规则使用规则"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/product_privileges_title"
        app:layout_constraintTop_toBottomOf="@+id/product_privileges_title"/>
    <View
        android:layout_width="0dp"
        android:layout_height="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/product_privileges_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
