<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.module.keymapeditor.componentsettingsview.LongPressGroupComponentSettingsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/component_settings_view_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keymap_component_settings_intro_title"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/long_press_group_component_settings_view_prompt"/>
        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp"/>
        <ImageView
            android:id="@+id/imageView9"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:src="@drawable/white_dotted_line"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp"/>
        <com.zjx.jyandroid.base.Components.ModifyBindingKeyComponent
            android:orientation="horizontal"
            android:id="@+id/modifyBindingKeyComponent"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/long_press_group_component_settings_view_trigger_mode"
                android:layout_weight="0"/>
            <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                android:layout_gravity="center_horizontal"
                android:id="@+id/triggerModeSegmentedControl"
                android:background="@color/settings_segmented_control_background"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_phone"
                android:layout_weight="1"
                android:elevation="0dp"
                app:borderColor="@color/settings_segmented_control_background"
                app:borderWidth="0dp"
                app:divider="@color/settings_segmented_control_divider"
                app:dividerPadding="5dp"
                app:dividerWidth="1dp"
                app:draggable="true"
                app:position="0"
                app:radius="5dp"
                app:ripple="true"
                app:rippleColor="@color/white"
                app:selectedBackground="@color/white"
                app:selectionAnimationDuration="200">
                <com.addisonelliott.segmentedbutton.SegmentedButton
                    android:padding="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    app:drawableGravity="top"
                    app:selectedTextColor="@color/component_settings_view_background"
                    app:selectedTextStyle="bold"
                    app:text="@string/long_press_group_component_settings_view_trigger_mode_trigger_all"
                    app:textColor="@color/component_settings_view_background"
                    app:textSize="13sp"/>
                <com.addisonelliott.segmentedbutton.SegmentedButton
                    android:padding="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    app:drawableGravity="top"
                    app:selectedTextColor="@color/component_settings_view_background"
                    app:selectedTextStyle="bold"
                    app:text="@string/long_press_group_component_settings_view_trigger_mode_trigger_last_one"
                    app:textColor="@color/component_settings_view_background"
                    app:textSize="13sp"/>
            </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>
            <Space
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/long_press_group_component_settings_view_terminate_mode"
                android:layout_weight="0"/>
            <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                android:layout_gravity="center_horizontal"
                android:id="@+id/terminateModeSegmentedControl"
                android:background="@color/settings_segmented_control_background"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_phone"
                android:layout_weight="1"
                android:elevation="0dp"
                app:borderColor="@color/settings_segmented_control_background"
                app:borderWidth="0dp"
                app:divider="@color/settings_segmented_control_divider"
                app:dividerPadding="5dp"
                app:dividerWidth="1dp"
                app:draggable="true"
                app:position="0"
                app:radius="5dp"
                app:ripple="true"
                app:rippleColor="@color/white"
                app:selectedBackground="@color/white"
                app:selectionAnimationDuration="200">
                <com.addisonelliott.segmentedbutton.SegmentedButton
                    android:padding="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    app:drawableGravity="top"
                    app:selectedTextColor="@color/component_settings_view_background"
                    app:selectedTextStyle="bold"
                    app:text="@string/long_press_group_component_settings_view_terminate_mode_terminate_all"
                    app:textColor="@color/component_settings_view_background"
                    app:textSize="13sp"/>
                <com.addisonelliott.segmentedbutton.SegmentedButton
                    android:padding="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    app:drawableGravity="top"
                    app:selectedTextColor="@color/component_settings_view_background"
                    app:selectedTextStyle="bold"
                    app:text="@string/long_press_group_component_settings_view_terminate_mode_terminate_last_one"
                    app:textColor="@color/component_settings_view_background"
                    app:textSize="13sp"/>
            </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>
            <Space
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/componentsLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</com.zjx.jyandroid.module.keymapeditor.componentsettingsview.LongPressGroupComponentSettingsView>
