<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.module.keymapeditor.componentsettingsview.FreeLookComponentSettingsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/component_settings_view_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keymap_component_settings_intro_title"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/free_look_component_settings_view_prompt"/>
        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp"/>
        <ImageView
            android:id="@+id/imageView9"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:src="@drawable/white_dotted_line"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp"/>
        <com.zjx.jyandroid.base.Components.ModifyBindingKeyComponent
            android:orientation="horizontal"
            android:id="@+id/modifyBindingKeyComponent"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="30dp">
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/free_look_component_settings_view_title_sensitivity"/>
            <Space
                android:layout_width="30dp"
                android:layout_height="wrap_content"/>
            <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                android:id="@+id/valueSliderView"
                android:layout_width="@dimen/slider_width_phone"
                android:layout_height="match_parent"
                app:sliderMax="1000"
                app:sliderMin="50"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/helpIcon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_help"
                android:tint="@color/white"
                android:layout_weight="0"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="30dp">
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/free_look_component_settings_view_title_reset_on_edge"
                android:layout_weight="0"/>
            <Space
                android:layout_width="20dp"
                android:layout_height="match_parent"
                android:layout_weight="0"/>
            <Switch
                android:id="@+id/resetOnEdgeSwitch"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:thumbTint="@drawable/switch_thumb"
                android:trackTint="@drawable/switch_track"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/reactivateJoystickHelpIcon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_help"
                android:tint="@color/white"
                android:layout_weight="0"/>
        </LinearLayout>
    </LinearLayout>
</com.zjx.jyandroid.module.keymapeditor.componentsettingsview.FreeLookComponentSettingsView>
