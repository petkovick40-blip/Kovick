<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.base.CustomViews.AlertView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#4a000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/baseContainer"
        android:background="@drawable/alert_view_background"
        android:paddingTop="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#ff1d1d1f"
            android:gravity="center_horizontal"
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="header"
            android:letterSpacing="0.05"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/contentTextView"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:maxWidth="230dp"
            android:minWidth="200dp"
            android:text="Content"
            android:maxLines="8"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="15dp"/>
        <EditText
            android:textSize="@dimen/font_size_text_phone"
            android:textColor="@color/black"
            android:id="@+id/editText"
            android:background="@drawable/alert_view_edit_text_background"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="15dp"
            android:ems="5"
            android:inputType="textPersonName"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/actionsContainer"
            android:layout_width="match_parent"
            android:layout_height="40dp"/>
    </LinearLayout>
</com.zjx.jyandroid.base.CustomViews.AlertView>
