<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cellContainer"
    android:background="@color/jy_blue_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="30dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:id="@+id/headerTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/manage_pubg_rc_data_row_title"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:id="@+id/versionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1.0.0"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:id="@+id/statusTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/manage_pubg_rc_data_row_undownloaded"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="0">
            <TableLayout
                android:gravity="center_vertical"
                android:id="@+id/buttonsTableLayout"
                android:paddingTop="5dp"
                android:paddingBottom="3dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <Button
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:id="@+id/shareButton"
                        android:background="@drawable/rounded_button_background_15dp"
                        android:layout_width="60dp"
                        android:layout_height="30dp"
                        android:text="@string/share"
                        android:backgroundTint="@android:color/holo_orange_dark"/>
                    <Space
                        android:layout_width="5dp"
                        android:layout_height="wrap_content"/>
                    <Button
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:id="@+id/uploadButton"
                        android:background="@drawable/rounded_button_background_15dp"
                        android:layout_width="60dp"
                        android:layout_height="30dp"
                        android:text="@string/upload"
                        android:backgroundTint="@color/system_green"/>
                </TableRow>
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <Button
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:id="@+id/renameButton"
                        android:background="@drawable/rounded_button_background_15dp"
                        android:layout_width="60dp"
                        android:layout_height="30dp"
                        android:text="@string/rename"
                        android:backgroundTint="@android:color/darker_gray"/>
                    <Space
                        android:layout_width="5dp"
                        android:layout_height="wrap_content"/>
                    <Button
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:id="@+id/deleteButton"
                        android:background="@drawable/rounded_button_background_15dp"
                        android:layout_width="60dp"
                        android:layout_height="30dp"
                        android:text="@string/delete"
                        android:backgroundTint="@color/danger_red"/>
                </TableRow>
            </TableLayout>
            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/jy_blue_1"
                    android:id="@+id/selectButton"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:text="@string/manage_pubg_rc_data_row_select_data"
                    android:layout_weight="1"
                    android:backgroundTint="@color/white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.zjx.jyandroid.base.Components.IconView
                    android:id="@+id/selectedIndicator"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginRight="20dp"
                    android:tint="#ffffffff"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_correct"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
