<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@drawable/account_page_card_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/title_bar"
        layout="@layout/account_cell_title_bar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/account_card_padding"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/account_primary_color"
        android:gravity="center"
        android:id="@+id/check_in_button"
        android:background="@drawable/account_page_card_background"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/account_page_daily_check_in"
        android:backgroundTint="#ffffde37"
        android:layout_marginHorizontal="@dimen/account_card_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recycler_view"/>
    <View
        android:id="@+id/red_point"
        android:background="@drawable/ic_red_point"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="@+id/check_in_button"
        app:layout_constraintTop_toTopOf="@+id/check_in_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
