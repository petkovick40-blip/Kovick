<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.ForegroundService.UI.RootFloatingPanelView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="100">
        <androidx.cardview.widget.CardView
            android:background="#cf4f6bf8"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="72"
            app:cardBackgroundColor="#cf4f6bf8"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/buttonsLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/selectKeymapLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:weightSum="100"
                    android:layout_weight="1">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="80">
                        <ImageView
                            android:id="@+id/selectKeymapImageView"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:src="@drawable/rootfloatingpanel_select_keymap_icon"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true"
                            android:contentDescription="select_keymap_icon"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#ffffffff"
                        android:id="@+id/selectKeymapTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/root_floating_panel_select_keymap"
                        android:layout_weight="1"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/uploadKeymapLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:weightSum="100"
                    android:layout_weight="1">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="80">
                        <ImageView
                            android:id="@+id/uploadKeymapImageView"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:src="@drawable/rootfloatingpanel_keymap_upload_icon"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true"
                            android:contentDescription="switch_config"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#ffffffff"
                        android:id="@+id/uploadKeymapTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/root_floating_panel_adjust_keymap"
                        android:layout_weight="1"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/settingsLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:weightSum="100"
                    android:layout_weight="1">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="80">
                        <ImageView
                            android:id="@+id/settingsImageView"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:src="@drawable/rootfloatingpanel_settings_icon"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true"
                            android:contentDescription="switch_config"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#ffffffff"
                        android:id="@+id/settingsTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/root_floating_panel_settings"
                        android:layout_weight="1"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/returnLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:weightSum="100"
                    android:layout_weight="1">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="80">
                        <ImageView
                            android:id="@+id/returnImageView"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:src="@drawable/rootfloatingpanel_return_icon"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true"
                            android:contentDescription="switch_config"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#ffffffff"
                        android:id="@+id/returnTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/root_floating_panel_return_app"
                        android:layout_weight="1"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/switchKeyboardTypingModeLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:weightSum="100"
                    android:layout_weight="1">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="80">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:src="@drawable/rootfloatingpanel_lock_keyboard_icon"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true"
                            android:contentDescription="switch_config"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#ffffffff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/root_floating_panel_switch_grabbing_keyboard"
                        android:layout_weight="1"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/tutorialLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:weightSum="100"
                    android:layout_weight="1">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="80">
                        <ImageView
                            android:id="@+id/tutorialImageView"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:src="@drawable/ic_help"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true"
                            android:tint="@color/white"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#ffffffff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/root_floating_panel_tutorial"
                        android:layout_weight="1"
                        android:textAlignment="center"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:weightSum="100"
            android:layout_weight="28">
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="80"/>
            <ImageView
                android:id="@+id/hidePanelImageView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/rootfloatingpanel_hide_icon"
                android:layout_weight="20"/>
        </LinearLayout>
    </LinearLayout>
</com.zjx.jyandroid.ForegroundService.UI.RootFloatingPanelView>
