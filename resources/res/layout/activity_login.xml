<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <TextView
                android:textColor="@color/jy_blue_1"
                android:gravity="center"
                android:id="@+id/finishButton"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/finish"
                android:layout_weight="0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#ff333333"
            android:gravity="center"
            android:id="@+id/textView24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/activity_login_title_login_by_email"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="5dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#ff333333"
            android:gravity="center"
            android:id="@+id/textView26"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/activity_login_title_auto_register_text"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:descendantFocusability="beforeDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="30dp"
            android:paddingEnd="30dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_login_text_header_email"/>
                <EditText
                    android:textSize="16sp"
                    android:id="@+id/emailTextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/activity_login_email_input_placeholder_text"
                    android:ems="8"
                    android:inputType="text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/verificationCodeLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView
                    android:id="@+id/sendCodeButton"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:backgroundTint="@color/jy_blue_1"
                    app:cardCornerRadius="3dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@+id/sendEmailButtonTextView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/activity_reset_password_button_send_code"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0"/>
                        <ProgressBar
                            android:id="@+id/sendEmailProgressLoader"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="?android:attr/progressBarStyle"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_login_text_header_verification_code"/>
                    <EditText
                        android:textSize="16sp"
                        android:id="@+id/verificationCodeTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="7dp"
                        android:hint="@string/activity_reset_password_verification_code_placeholder"
                        android:ems="8"
                        android:inputType="text"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/jy_blue_1"
                        android:gravity="start"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_reset_password_check_junk_mail_box"/>
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_login_text_header_password"/>
                <EditText
                    android:textSize="16sp"
                    android:id="@+id/passwordTextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/activity_login_password_input_placeholder_text"
                    android:ems="8"
                    android:inputType="textPassword"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/forgotPasswordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/jy_blue_1"
                    android:gravity="start"
                    android:id="@+id/forgotPasswordButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_login_button_switch_between_text_forgot_password"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/confirmPasswordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_login_text_header_confirm_password"/>
                <EditText
                    android:textSize="16sp"
                    android:id="@+id/confirmPasswordInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/activity_login_confirm_password_input_placeholder_text"
                    android:ems="8"
                    android:inputType="textPassword"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/invitationCodeLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_login_text_header_invitation_code"/>
                <EditText
                    android:textSize="16sp"
                    android:id="@+id/invitationCodeInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/activity_login_invitation_code_input_placeholder_text"
                    android:ems="8"
                    android:inputType="text"/>
            </LinearLayout>
            <androidx.cardview.widget.CardView
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:backgroundTint="@color/jy_blue_1"
                app:cardCornerRadius="15dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/loginButtonText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/activity_login_button_text_login"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0"/>
                    <ProgressBar
                        android:id="@+id/progressLoader"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="?android:attr/progressBarStyle"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <Space
                android:layout_width="match_parent"
                android:layout_height="10dp"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/jy_blue_1"
                android:gravity="center"
                android:id="@+id/switchModeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/activity_login_button_switch_between_text_register"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="10dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <CheckBox
                    android:textSize="10sp"
                    android:textColor="@android:color/darker_gray"
                    android:id="@+id/checkBox"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:checked="true"
                    android:scaleX="0.7"
                    android:scaleY="0.7"
                    android:buttonTint="@color/jy_blue_1"/>
                <TextView
                    android:textSize="10sp"
                    android:id="@+id/textView33"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_login_text5"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="10dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/otherLoginMethodsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:gravity="center"
                    android:id="@+id/textView32"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_login_text_other_login_methods"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="5dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.5">
                        <ImageButton
                            android:id="@+id/loginWithGoogleButton"
                            android:background="@drawable/rounded_button_background_10dp"
                            android:padding="5dp"
                            android:layout_width="39dp"
                            android:layout_height="39dp"
                            android:src="@drawable/ic_google_colored"
                            android:scaleType="fitXY"
                            android:backgroundTint="@color/default_grey_separator"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
