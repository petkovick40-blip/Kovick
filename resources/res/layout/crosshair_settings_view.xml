<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.Extensions.Crosshair.CrosshairSettingsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/jy_blue_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp">
            <com.zjx.jyandroid.base.Components.TextWithSwitchView
                android:id="@+id/enableCell"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:showSubtitle="false"
                app:titleSize="@dimen/font_size_text_phone"
                app:titleText="@string/crosshair_settings_view_text1"
                app:titleTextColor="#ffffffff"/>
            <View
                android:id="@+id/view36"
                android:background="#6affffff"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_weight="1"/>
            <com.zjx.jyandroid.base.Components.TextWithSwitchView
                android:id="@+id/autoHiddenWhenAimingCell"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:showSubtitle="false"
                app:titleSize="@dimen/font_size_text_phone"
                app:titleText="@string/crosshair_settings_view_text2"
                app:titleTextColor="#ffffffff"/>
            <View
                android:id="@+id/view37"
                android:background="#6affffff"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <com.zjx.jyandroid.base.Components.TextWithSwitchView
                android:id="@+id/customizedCrosshair"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:showSubtitle="false"
                app:titleSize="@dimen/font_size_text_phone"
                app:titleText="@string/crosshair_settings_view_text3"
                app:titleTextColor="#ffffffff"/>
            <View
                android:id="@+id/view43"
                android:background="#6affffff"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/textView40"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/crosshair_settings_view_text4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <Spinner
                    android:id="@+id/spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:popupBackground="@color/jy_blue_1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/view38"
                android:background="#6affffff"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/sizeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/crosshair_settings_view_text9"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                    android:id="@+id/sizeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="100dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/sizeTextView"
                    app:layout_constraintTop_toTopOf="parent"
                    app:sliderMax="500"
                    app:sliderMin="5"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/view39"
                android:background="#6affffff"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/colorTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/crosshair_settings_view_text10"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/colorSettingsView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="100dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/colorTextView"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.zjx.jyandroid.Extensions.Crosshair.ColorHolderComponent
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        app:centerViewColor="@color/white"/>
                    <com.zjx.jyandroid.Extensions.Crosshair.ColorHolderComponent
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        app:centerViewColor="@color/black"/>
                    <com.zjx.jyandroid.Extensions.Crosshair.ColorHolderComponent
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        app:centerViewColor="@color/system_red"/>
                    <com.zjx.jyandroid.Extensions.Crosshair.ColorHolderComponent
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        app:centerViewColor="@color/system_green"/>
                    <com.zjx.jyandroid.Extensions.Crosshair.ColorHolderComponent
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        app:centerViewColor="@color/purple_200"/>
                    <com.zjx.jyandroid.Extensions.Crosshair.ColorHolderComponent
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        app:centerViewColor="@color/warning_yellow"/>
                    <com.zjx.jyandroid.Extensions.Crosshair.ColorHolderComponent
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        app:centerViewColor="#ffffa500"/>
                    <com.zjx.jyandroid.Extensions.Crosshair.ColorHolderComponent
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        app:centerViewColor="#ff00ffff"/>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/redTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/crosshair_settings_view_text11"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                    android:id="@+id/redSlider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="100dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/redTextView"
                    app:layout_constraintTop_toTopOf="parent"
                    app:sliderMax="255"
                    app:sliderMin="0"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/greenTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/crosshair_settings_view_text12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                    android:id="@+id/greenSlider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="100dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/greenTextView"
                    app:layout_constraintTop_toTopOf="parent"
                    app:sliderMax="255"
                    app:sliderMin="0"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/blueTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/crosshair_settings_view_text13"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                    android:id="@+id/blueSlider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="100dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/blueTextView"
                    app:layout_constraintTop_toTopOf="parent"
                    app:sliderMax="255"
                    app:sliderMin="0"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/transparencyTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/crosshair_settings_view_text14"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                    android:id="@+id/transparencySlider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="100dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/transparencyTextView"
                    app:layout_constraintTop_toTopOf="parent"
                    app:sliderMax="255"
                    app:sliderMin="0"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/view40"
                android:background="#6affffff"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/crosshair_settings_view_text15"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                    android:id="@+id/horizontalOffsetSlider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="100dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/textView2"
                    app:layout_constraintTop_toTopOf="parent"
                    app:sliderMax="100"
                    app:sliderMin="-100"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/view41"
                android:background="#6affffff"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/textView1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/crosshair_settings_view_text16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                    android:id="@+id/verticalOffsetSlider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="100dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/textView1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:sliderMax="100"
                    app:sliderMin="-100"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/view42"
                android:background="#6affffff"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
        </LinearLayout>
    </ScrollView>
</com.zjx.jyandroid.Extensions.Crosshair.CrosshairSettingsView>
