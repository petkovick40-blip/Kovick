<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.Extensions.pubg.componentsettingsview.SwitchZoomingComponentSettingsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/component_settings_view_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keymap_component_settings_intro_title"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/switch_rc_panel_display_settings_prompt"/>
        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp"/>
        <ImageView
            android:id="@+id/imageView9"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:src="@drawable/white_dotted_line"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp"/>
        <com.zjx.jyandroid.base.Components.ModifyBindingKeyComponent
            android:orientation="horizontal"
            android:id="@+id/modifyBindingKeyComponent"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>
        <ImageView
            android:id="@+id/imageView8"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:src="@drawable/white_dotted_line"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="25dp">
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="触发方式"/>
            <Space
                android:layout_width="30dp"
                android:layout_height="wrap_content"/>
            <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                android:layout_gravity="center_horizontal"
                android:id="@+id/triggerModeSegmentedControl"
                android:background="@color/settings_segmented_control_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="0dp"
                app:borderColor="@color/settings_segmented_control_background"
                app:borderWidth="0dp"
                app:divider="@color/settings_segmented_control_divider"
                app:dividerPadding="5dp"
                app:dividerWidth="1dp"
                app:draggable="true"
                app:position="0"
                app:radius="5dp"
                app:ripple="true"
                app:rippleColor="@color/white"
                app:selectedBackground="@color/white"
                app:selectionAnimationDuration="200">
                <com.addisonelliott.segmentedbutton.SegmentedButton
                    android:padding="7dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:drawableGravity="top"
                    app:selectedTextColor="@color/component_settings_view_background"
                    app:selectedTextStyle="bold"
                    app:text="按下按键触发"
                    app:textColor="@color/component_settings_view_background"
                    app:textSize="@dimen/font_size_text_phone"/>
                <com.addisonelliott.segmentedbutton.SegmentedButton
                    android:padding="7dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:drawableGravity="top"
                    app:selectedTextColor="@color/component_settings_view_background"
                    app:selectedTextStyle="bold"
                    app:text="抬起按键触发"
                    app:textColor="@color/component_settings_view_background"
                    app:textSize="@dimen/font_size_text_phone"/>
                <com.addisonelliott.segmentedbutton.SegmentedButton
                    android:id="@+id/segmentedButton6"
                    android:padding="7dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:drawableGravity="top"
                    app:selectedTextColor="@color/component_settings_view_background"
                    app:selectedTextStyle="bold"
                    app:text="按下+抬起触发"
                    app:textColor="@color/component_settings_view_background"
                    app:textSize="@dimen/font_size_text_phone"/>
            </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>
            <Space
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="25dp">
            <TextView
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="倍率切换选项"/>
            <Space
                android:layout_width="30dp"
                android:layout_height="wrap_content"/>
            <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                android:layout_gravity="center_horizontal"
                android:id="@+id/switchZoomingTypeSegmentedControl"
                android:background="@color/settings_segmented_control_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="0dp"
                app:borderColor="@color/settings_segmented_control_background"
                app:borderWidth="0dp"
                app:divider="@color/settings_segmented_control_divider"
                app:dividerPadding="5dp"
                app:dividerWidth="1dp"
                app:draggable="true"
                app:position="0"
                app:radius="5dp"
                app:ripple="true"
                app:rippleColor="@color/white"
                app:selectedBackground="@color/white"
                app:selectionAnimationDuration="200">
                <com.addisonelliott.segmentedbutton.SegmentedButton
                    android:padding="7dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:drawableGravity="top"
                    app:selectedTextColor="@color/component_settings_view_background"
                    app:selectedTextStyle="bold"
                    app:text="循环切"
                    app:textColor="@color/component_settings_view_background"
                    app:textSize="@dimen/font_size_text_phone"/>
                <com.addisonelliott.segmentedbutton.SegmentedButton
                    android:padding="7dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:drawableGravity="top"
                    app:selectedTextColor="@color/component_settings_view_background"
                    app:selectedTextStyle="bold"
                    app:text="切高倍率(6或8)"
                    app:textColor="@color/component_settings_view_background"
                    app:textSize="@dimen/font_size_text_phone"/>
                <com.addisonelliott.segmentedbutton.SegmentedButton
                    android:padding="7dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:drawableGravity="top"
                    app:selectedTextColor="@color/component_settings_view_background"
                    app:selectedTextStyle="bold"
                    app:text="切低倍率(3或4)"
                    app:textColor="@color/component_settings_view_background"
                    app:textSize="@dimen/font_size_text_phone"/>
            </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>
            <Space
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</com.zjx.jyandroid.Extensions.pubg.componentsettingsview.SwitchZoomingComponentSettingsView>
