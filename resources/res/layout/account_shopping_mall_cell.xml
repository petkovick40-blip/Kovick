<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="218dp">
    <View
        android:id="@+id/top_background"
        android:background="@drawable/account_shopping_mall_top_bg"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/level_tag"
        android:background="@drawable/account_shopping_level_bg"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        app:layout_constraintEnd_toEndOf="@+id/top_background"
        app:layout_constraintTop_toTopOf="@+id/top_background">
        <ImageView
            android:id="@+id/level_icon"
            android:layout_width="10dp"
            android:layout_height="12dp"
            android:src="@drawable/account_level_icon1"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/white"
            android:id="@+id/level_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="青铜专属"
            android:maxLines="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="26dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/level_icon"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/bottom_background"
        android:background="@drawable/account_shopping_mall_bottom_bg"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        app:layout_constraintTop_toBottomOf="@+id/top_background"/>
    <ImageView
        android:id="@+id/image"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/account_shopping_mall_image_default"
        app:layout_constraintBottom_toBottomOf="@+id/top_background"
        app:layout_constraintEnd_toEndOf="@+id/top_background"
        app:layout_constraintStart_toStartOf="@+id/top_background"
        app:layout_constraintTop_toTopOf="@+id/top_background"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="商品名称"
        android:lines="3"
        android:layout_marginHorizontal="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottom_background"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="1200积分"
        android:maxLines="1"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:id="@+id/description2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="50人已兑换"
        android:maxLines="1"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/description"/>
</androidx.constraintlayout.widget.ConstraintLayout>
