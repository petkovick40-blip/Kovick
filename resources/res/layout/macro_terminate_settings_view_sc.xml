<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.MacroTerminateComponentSettingsViewSC xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/component_settings_view_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keymap_component_settings_intro_title"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="7dp"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:id="@+id/textView4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_terminate_settings_view_sc_text1"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:src="@drawable/white_dotted_line"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_phone">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="65dp"
                    android:layout_height="match_parent"
                    android:text="@string/type_with_colon"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
                <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/triggerTypeSegmentedControl"
                    android:background="@color/settings_segmented_control_background"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:elevation="0dp"
                    app:borderColor="@color/settings_segmented_control_background"
                    app:borderWidth="0dp"
                    app:divider="@color/settings_segmented_control_divider"
                    app:dividerPadding="5dp"
                    app:dividerWidth="1dp"
                    app:draggable="true"
                    app:position="0"
                    app:radius="5dp"
                    app:ripple="true"
                    app:rippleColor="@color/white"
                    app:selectedBackground="@color/white"
                    app:selectionAnimationDuration="200">
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/key_type_shadow"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_text_phone"/>
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/key_type_bind_key"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_text_phone"/>
                </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/bindKeyLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="65dp"
                    android:layout_height="match_parent"
                    android:text="@string/component_settings_bind_key"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/bindKeyLabel"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:text="@string/empty"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
                <Button
                    android:textSize="12dp"
                    android:textColor="@color/component_settings_view_background"
                    android:id="@+id/changeKeyButton"
                    android:background="@drawable/button_rounded_white"
                    android:layout_width="@dimen/button_width_phone"
                    android:layout_height="@dimen/button_height_phone"
                    android:text="@string/modify"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/blockTouchLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="65dp"
                    android:layout_height="match_parent"
                    android:text="@string/block_touch"/>
                <Switch
                    android:id="@+id/blockTouchSwitch"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:thumbTint="@drawable/switch_thumb"
                    android:trackTint="@drawable/switch_track"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <ImageView
                android:id="@+id/imageView10"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:src="@drawable/white_dotted_line"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="65dp"
                    android:layout_height="match_parent"
                    android:text="@string/macro_terminate_settings_view_sc_text2"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/bindMacroTextView"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:text="@string/macro_terminate_settings_view_sc_text3"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
                <Button
                    android:textSize="12dp"
                    android:textColor="@color/component_settings_view_background"
                    android:id="@+id/bindMacroButton"
                    android:background="@drawable/button_rounded_white"
                    android:layout_width="@dimen/button_width_phone"
                    android:layout_height="@dimen/button_height_phone"
                    android:text="@string/modify"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_phone">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/macro_terminate_settings_view_sc_text4"/>
                <Space
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"/>
                <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/terminateTypeSegmentedControl"
                    android:background="@color/settings_segmented_control_background"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height_phone"
                    android:elevation="0dp"
                    app:borderColor="@color/settings_segmented_control_background"
                    app:borderWidth="0dp"
                    app:divider="@color/settings_segmented_control_divider"
                    app:dividerPadding="5dp"
                    app:dividerWidth="1dp"
                    app:draggable="true"
                    app:position="0"
                    app:radius="5dp"
                    app:ripple="true"
                    app:rippleColor="@color/white"
                    app:selectedBackground="@color/white"
                    app:selectionAnimationDuration="200">
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/macro_terminate_settings_view_sc_text5"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_text_phone"/>
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/macro_terminate_settings_view_sc_text6"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_text_phone"/>
                </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_help"
                    android:tint="@color/white"
                    android:layout_weight="0"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/triggerTerminateModeLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_phone">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/macro_terminate_settings_view_sc_text7"/>
                <Space
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"/>
                <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/triggerTerminateModeSegmentedControl"
                    android:background="@color/settings_segmented_control_background"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height_phone"
                    android:elevation="0dp"
                    app:borderColor="@color/settings_segmented_control_background"
                    app:borderWidth="0dp"
                    app:divider="@color/settings_segmented_control_divider"
                    app:dividerPadding="5dp"
                    app:dividerWidth="1dp"
                    app:draggable="true"
                    app:position="0"
                    app:radius="5dp"
                    app:ripple="true"
                    app:rippleColor="@color/white"
                    app:selectedBackground="@color/white"
                    app:selectionAnimationDuration="200">
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/macro_terminate_settings_view_sc_text8"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_text_phone"/>
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/macro_terminate_settings_view_sc_text9"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_text_phone"/>
                </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_help"
                    android:tint="@color/white"
                    android:layout_weight="0"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_weight="0"/>
        </LinearLayout>
    </ScrollView>
</com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.MacroTerminateComponentSettingsViewSC>
