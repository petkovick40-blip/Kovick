<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.module.keymapeditor.ComponentSettingsContainerViewWangzuo xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/jy_blue_2"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:weightSum="100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="98"/>
        <Button
            android:textColor="@color/white"
            android:id="@+id/finishButton"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/finish"
            android:layout_weight="0"/>
        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="2"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="40dp"
        android:weightSum="100"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ScrollView
            android:background="@color/jy_blue_1"
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:fadeScrollbars="false">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sidePanelLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Button
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/normalTouchPointButton"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/component_settings_container_view_normal_touch_btn"
                    android:fontFamily="sans-serif"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/swipeTouchPointButton"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/component_settings_container_view_swipe_touch_btn"
                    android:fontFamily="sans-serif"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/mouseScrollButton"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/component_settings_container_view_scroll_btn"
                    android:fontFamily="sans-serif"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/macroButton"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/component_settings_container_view_macro_btn"
                    android:fontFamily="sans-serif"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/joystickButton"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/component_settings_container_view_joystick_btn"
                    android:fontFamily="sans-serif"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/fpsViewButton"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/component_settings_container_view_fps_view_btn"
                    android:fontFamily="sans-serif"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/freeLookButton"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/component_settings_container_view_free_look_btn"
                    android:fontFamily="sans-serif"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/longPressTriggerButton"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/component_settings_container_view_long_press_trigger_btn"
                    android:fontFamily="sans-serif"
                    android:stateListAnimator="@null"/>
                <Button
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/multifunctionalButton"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/component_settings_container_view_more_btn"
                    android:fontFamily="sans-serif"
                    android:stateListAnimator="@null"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ffe1e1e1"
                    android:gravity="end"
                    android:id="@+id/showAllButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/component_settings_container_view_show_all_btn"/>
            </LinearLayout>
        </ScrollView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/componentSettingsView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</com.zjx.jyandroid.module.keymapeditor.ComponentSettingsContainerViewWangzuo>
