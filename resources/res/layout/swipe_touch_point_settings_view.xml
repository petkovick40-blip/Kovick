<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.module.keymapeditor.componentsettingsview.SwipeTouchComponentSettingsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/component_settings_view_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keymap_component_settings_intro_title"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="5dp"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:id="@+id/textView4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/swipe_touch_point_settings_prompt"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="5dp"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:src="@drawable/white_dotted_line"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="25dp">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/component_settings_bind_key"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/bindKeyLabel"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:text="@string/empty"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
                <Button
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/component_settings_view_background"
                    android:id="@+id/changeKeyButton"
                    android:background="@drawable/button_rounded_white"
                    android:layout_width="@dimen/button_width_phone"
                    android:layout_height="wrap_content"
                    android:text="@string/modify"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:src="@drawable/white_dotted_line"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/swipe_touch_point_text1"/>
                <Space
                    android:layout_width="45dp"
                    android:layout_height="wrap_content"/>
                <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/typeSegmentedControl"
                    android:background="@color/settings_segmented_control_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="0dp"
                    app:borderColor="@color/settings_segmented_control_background"
                    app:borderWidth="0dp"
                    app:divider="@color/settings_segmented_control_divider"
                    app:dividerPadding="5dp"
                    app:dividerWidth="1dp"
                    app:draggable="true"
                    app:position="0"
                    app:radius="5dp"
                    app:ripple="true"
                    app:rippleColor="@color/white"
                    app:selectedBackground="@color/white"
                    app:selectionAnimationDuration="200">
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_phone"
                        android:layout_weight="1"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/swipe_touch_point_text2"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_subtext_phone"/>
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:padding="7dp"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_phone"
                        android:layout_weight="1"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/swipe_touch_point_text3"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_subtext_phone"/>
                    <com.addisonelliott.segmentedbutton.SegmentedButton
                        android:id="@+id/segmentedButton3"
                        android:padding="7dp"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_phone"
                        android:layout_weight="1"
                        app:drawableGravity="top"
                        app:selectedTextColor="@color/component_settings_view_background"
                        app:selectedTextStyle="bold"
                        app:text="@string/swipe_touch_point_text4"
                        app:textColor="@color/component_settings_view_background"
                        app:textSize="@dimen/font_size_subtext_phone"/>
                </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/typeHelpIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_help"
                    android:tint="@color/white"
                    android:layout_weight="0"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/mouseHorizontalSettingsStack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/font_size_subtext_phone"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/swipe_touch_point_text5"
                        android:layout_weight="0"/>
                    <Space
                        android:layout_width="25dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"/>
                    <Switch
                        android:id="@+id/mouseModeHorizontalSwipeSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:thumbTint="@drawable/switch_thumb"
                        android:trackTint="@drawable/switch_track"/>
                    <Space
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <ImageView
                        android:id="@+id/horizontalSwipeHelpIcon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_help"
                        android:tint="@color/white"
                        android:layout_weight="0"/>
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="5dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="32dp">
                <TextView
                    android:textSize="@dimen/font_size_subtext_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/swipe_touch_point_text6"/>
                <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                    android:id="@+id/swipeDurationSlider"
                    android:layout_width="@dimen/slider_width_phone"
                    android:layout_height="@dimen/slider_height_phone"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="0"/>
            <ImageView
                android:id="@+id/imageView7"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:src="@drawable/white_dotted_line"
                android:layout_weight="0"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="0"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:paddingRight="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/swipe_touch_point_text_tap_before_swipe"
                    android:layout_weight="0"/>
                <Switch
                    android:id="@+id/tapBeforeSwipeSwitch"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:thumbTint="@drawable/switch_thumb"
                    android:trackTint="@drawable/switch_track"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_help"
                    android:tint="@color/white"
                    android:layout_weight="0"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="0"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:paddingRight="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/swipe_touch_point_text_tap_after_swipe"
                    android:layout_weight="0"/>
                <Switch
                    android:id="@+id/tapAfterSwipeSwitch"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:thumbTint="@drawable/switch_thumb"
                    android:trackTint="@drawable/switch_track"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_help"
                    android:tint="@color/white"
                    android:layout_weight="0"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_weight="0"/>
        </LinearLayout>
    </ScrollView>
</com.zjx.jyandroid.module.keymapeditor.componentsettingsview.SwipeTouchComponentSettingsView>
