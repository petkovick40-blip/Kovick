<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.Macro.MacroOperationViews.MacroOperationViewPerformAimingRecognition xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_button_background_5dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/white">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/jy_blue_1"
            android:gravity="center_vertical"
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/macro_operation_view_perform_aiming_recognition_text1"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/font_size_subtext_phone"
                android:gravity="center_vertical"
                android:id="@+id/positionTextView3"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/macro_operation_view_perform_aiming_recognition_text2"
                android:layout_weight="0"/>
            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:layout_weight="0"/>
            <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                android:id="@+id/slider"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:layout_weight="0"
                app:mainColor="@color/jy_blue_1"
                app:seekbarDrawable="@drawable/thick_seek_bar_phone_blue"
                app:thumbDrawable="@drawable/thick_seek_bar_thumb_phone_blue"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</com.zjx.jyandroid.ForegroundService.UI.UploadKeymapModule.ComponentSettingsViews.Macro.MacroOperationViews.MacroOperationViewPerformAimingRecognition>
