                        android:id="@+id/horizontalSpeedAfterSwitchSliderView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/slider_height_phone"/>
                </LinearLayout>
                <Space
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="@dimen/slider_width_phone"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
