<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.MainApp.AccountPageView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/navigationBar"
        android:background="@color/navigation_bar_background"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Space
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="0"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <ScrollView
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fadeScrollbars="false"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.cardview.widget.CardView
                android:id="@+id/accountCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/loginButtonCardView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="30dp"
                                app:cardCornerRadius="10dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_bias="0.5">
                                <TextView
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:id="@+id/loginButton"
                                    android:background="@color/jy_blue_1"
                                    android:layout_width="100dp"
                                    android:layout_height="30dp"
                                    android:text="@string/account_page_view_login_button_text"
                                    android:layout_weight="1"
                                    android:backgroundTint="@color/jy_blue_1"/>
                            </androidx.cardview.widget.CardView>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/linearLayout6"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">
                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:id="@+id/imageView11"
                                        android:layout_width="0dp"
                                        android:layout_height="50dp"
                                        android:src="@drawable/ic_account"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintDimensionRatio="1:1"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintHorizontal_bias="0"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintVertical_bias="0.5"/>
                                </androidx.constraintlayout.widget.ConstraintLayout>
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:paddingTop="5dp"
                                    android:paddingBottom="5dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="10dp"
                                    android:layout_weight="1">
                                    <TextView
                                        android:textColor="@color/black"
                                        android:id="@+id/nickNameTextView"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/settings_page_view_text3"/>
                                    <Space
                                        android:layout_width="match_parent"
                                        android:layout_height="5dp"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:id="@+id/userTypeTextView"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/settings_page_view_text4"/>
                                    <Space
                                        android:layout_width="match_parent"
                                        android:layout_height="5dp"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:id="@+id/expireTimeTextView"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/settings_page_view_text4"/>
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <View
                            android:background="@color/jy_blue_1"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                        <TextView
                            android:textSize="10sp"
                            android:id="@+id/textView39"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/account_page_view_free_forever_text"
                            android:layout_weight="1"/>
                        <View
                            android:id="@+id/view46"
                            android:background="@color/default_grey_separator"
                            android:layout_width="match_parent"
                            android:layout_height="1px"
                            android:layout_weight="1"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/alreadyLoginBar"
                            android:layout_width="match_parent"
                            android:layout_height="30dp">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">
                                <TextView
                                    android:textColor="@color/jy_blue_1"
                                    android:gravity="center"
                                    android:id="@+id/depositButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:text="@string/account_page_view_deposit_button_text"
                                    android:layout_weight="1"/>
                                <TextView
                                    android:textColor="@color/jy_blue_1"
                                    android:gravity="center"
                                    android:id="@+id/myAccountButton"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:text="@string/account_page_view_my_account_button_text"
                                    android:layout_weight="1"/>
                                <TextView
                                    android:textColor="@color/jy_blue_1"
                                    android:gravity="center"
                                    android:id="@+id/refreshButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:text="@string/account_page_view_refresh_button_text"
                                    android:layout_weight="1"/>
                                <TextView
                                    android:textColor="@color/jy_blue_1"
                                    android:gravity="center"
                                    android:id="@+id/logoutButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:text="@string/account_page_view_logout_button_text"
                                    android:layout_weight="1"/>
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/privilegeDetails"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/account_page_view_privilege_header"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/jy_blue_1"
                android:id="@+id/alreadyPurchasedPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/account_page_view_check_order_text"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/planDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textColor="@color/black"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/account_page_view_plan_header"/>
                    <com.zjx.jyandroid.base.Components.ExpandedGridView
                        android:id="@+id/gridView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:verticalSpacing="10dp"
                        android:columnWidth="50dp"
                        android:numColumns="2"/>
                    <Space
                        android:layout_width="wrap_content"
                        android:layout_height="10dp"/>
                    <com.zjx.jyandroid.base.Components.ExpandedGridView
                        android:id="@+id/subscriptionGridView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:verticalSpacing="10dp"
                        android:columnWidth="50dp"
                        android:numColumns="2"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="30dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/letter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textColor="@color/black"
                        android:id="@+id/letterText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loadingBackground"
        android:background="#3a000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:id="@+id/progressLoader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            style="?android:attr/progressBarStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.zjx.jyandroid.MainApp.AccountPageView>
