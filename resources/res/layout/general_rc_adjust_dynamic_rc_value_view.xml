<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.Extensions.GeneralRC.AdjustDynamicRCValueView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#af000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="30dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/linearLayout7"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginBottom="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/textView17"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/adjust_dynamic_rc_value_view_text1"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/jy_blue_1"
                    android:id="@+id/weaponTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <Space
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="9sp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:id="@+id/textView15"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/adjust_dynamic_rc_value_view_text2"/>
                <TextView
                    android:textSize="9sp"
                    android:textColor="@color/jy_blue_1"
                    android:id="@+id/timeTextView"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0秒"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="15dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/font_size_subtext_phone"
                        android:textColor="@color/jy_blue_1"
                        android:gravity="center"
                        android:id="@+id/clearButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/adjust_dynamic_rc_value_view_text3"
                        android:layout_weight="1"/>
                    <Space
                        android:layout_width="15dp"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="@dimen/font_size_subtext_phone"
                        android:textColor="@color/danger_red"
                        android:gravity="center"
                        android:id="@+id/closeButton"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/adjust_dynamic_rc_value_view_text4"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/font_size_subtext_phone"
                        android:textColor="@color/jy_blue_1"
                        android:id="@+id/switchModeButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/general_rc_extension_adjust_dynamic_rc_value_view_mode_horizontal"
                        android:layout_weight="1"/>
                    <Space
                        android:layout_width="15dp"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="@dimen/font_size_subtext_phone"
                        android:textColor="@color/jy_blue_1"
                        android:id="@+id/multiselectButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/multiselect"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            style="?android:attr/progressBarStyleHorizontal"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ProgressBar
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            style="?android:attr/progressBarStyleHorizontal"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lineGraphViewHolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@+id/progressBarUnder"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:scaleY="42"
                app:layout_constraintBottom_toTopOf="@+id/horizontalRangeSlider"
                app:layout_constraintEnd_toStartOf="@+id/frameLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="?android:attr/progressBarStyleHorizontal"/>
            <com.zjx.jyandroid.base.Components.LineGraphView
                android:id="@+id/lineGraphView"
                android:background="#af5a65fa"
                android:layout_width="0dp"
                android:layout_height="130dp"
                app:layout_constraintBottom_toTopOf="@+id/horizontalRangeSlider"
                app:layout_constraintEnd_toStartOf="@+id/frameLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.material.slider.RangeSlider
                android:theme="@style/Theme.Jyandroid"
                android:id="@+id/horizontalRangeSlider"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:valueFrom="0"
                android:valueTo="15"
                app:haloRadius="0dp"
                app:labelStyle="@style/Widget.PubgExtension.Tooltip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lineGraphView"
                app:minSeparation="10dp"
                app:thumbColor="@color/white"
                app:thumbRadius="7dp"
                app:trackColorActive="@color/white"
                app:values="@array/initial_horizontal_dynamic_rc_value_slider_values"/>
            <FrameLayout
                android:orientation="vertical"
                android:id="@+id/frameLayout"
                android:layout_width="20dp"
                android:layout_height="120dp"
                app:layout_constraintBottom_toTopOf="@+id/horizontalRangeSlider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/lineGraphView"
                app:layout_constraintTop_toTopOf="parent">
                <com.google.android.material.slider.RangeSlider
                    android:theme="@style/Theme.Jyandroid"
                    android:layout_gravity="center"
                    android:id="@+id/verticalRangeSlider"
                    android:layout_width="160dp"
                    android:layout_height="20dp"
                    android:stepSize="1"
                    android:valueFrom="-300"
                    android:valueTo="800"
                    android:rotation="270"
                    app:labelStyle="@style/Widget.PubgExtension.Tooltip"
                    app:thumbColor="@color/white"
                    app:thumbRadius="7dp"
                    app:tickVisible="false"
                    app:trackColorActive="@color/white"
                    app:values="@array/initial_horizontal_dynamic_rc_value_slider_values"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <Button
                    android:textColor="@color/white"
                    android:id="@+id/upButton"
                    android:background="@drawable/up"
                    android:layout_width="50dp"
                    android:layout_height="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <Button
                    android:textColor="@color/white"
                    android:id="@+id/rightButton"
                    android:background="@drawable/right"
                    android:layout_width="20dp"
                    android:layout_height="50dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <Button
                    android:textColor="@color/white"
                    android:id="@+id/downButton"
                    android:background="@drawable/down"
                    android:layout_width="50dp"
                    android:layout_height="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <Button
                    android:textColor="@color/white"
                    android:id="@+id/leftButton"
                    android:background="@drawable/left"
                    android:layout_width="20dp"
                    android:layout_height="50dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content"
                android:layout_weight="0"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <Button
                            android:textColor="@color/white"
                            android:id="@+id/insertButton"
                            android:background="@drawable/rounded_button_background_5dp"
                            android:layout_width="45dp"
                            android:layout_height="match_parent"
                            android:text="@string/adjust_dynamic_rc_value_view_text5"
                            android:layout_weight="1"
                            android:backgroundTint="@color/jy_blue_1"
                            android:autoSizeTextType="uniform"
                            android:autoSizePresetSizes="12sp"
                            android:autoSizeMinTextSize="6sp"
                            android:autoSizeMaxTextSize="12sp"/>
                        <Space
                            android:layout_width="10dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <Button
                            android:textColor="@color/white"
                            android:id="@+id/deleteButton"
                            android:background="@drawable/rounded_button_background_5dp"
                            android:layout_width="45dp"
                            android:layout_height="match_parent"
                            android:text="@string/adjust_dynamic_rc_value_view_text6"
                            android:layout_weight="1"
                            android:backgroundTint="@color/danger_red"
                            android:autoSizeTextType="uniform"
                            android:autoSizePresetSizes="12sp"
                            android:autoSizeMinTextSize="6sp"
                            android:autoSizeMaxTextSize="12sp"/>
                    </LinearLayout>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_weight="0"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <Button
                            android:textColor="@color/white"
                            android:id="@+id/refreshButton"
                            android:background="@drawable/rounded_button_background_5dp"
                            android:layout_width="45dp"
                            android:layout_height="match_parent"
                            android:text="@string/adjust_dynamic_rc_value_view_text7"
                            android:layout_weight="1"
                            android:backgroundTint="@color/jy_blue_1"
                            android:autoSizeTextType="uniform"
                            android:autoSizePresetSizes="12sp"
                            android:autoSizeMinTextSize="6sp"
                            android:autoSizeMaxTextSize="12sp"/>
                        <Space
                            android:layout_width="10dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <Button
                            android:textColor="@color/white"
                            android:id="@+id/saveButton"
                            android:background="@drawable/rounded_button_background_5dp"
                            android:layout_width="45dp"
                            android:layout_height="match_parent"
                            android:text="@string/apply"
                            android:layout_weight="1"
                            android:backgroundTint="@color/success_green"
                            android:autoSizeTextType="uniform"
                            android:autoSizePresetSizes="12sp"
                            android:autoSizeMinTextSize="6sp"
                            android:autoSizeMaxTextSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </LinearLayout>
</com.zjx.jyandroid.Extensions.GeneralRC.AdjustDynamicRCValueView>
