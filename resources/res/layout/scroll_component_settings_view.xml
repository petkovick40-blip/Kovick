<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.module.keymapeditor.componentsettingsview.ScrollComponentSettingsView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/component_settings_view_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keymap_component_settings_intro_title"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="5dp"/>
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:id="@+id/textView4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scroll_settings_prompt"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:src="@drawable/white_dotted_line"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="@dimen/slider_width_phone"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scroll_settings_text1"/>
                    <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                        android:id="@+id/heightSliderView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/slider_height_phone"/>
                </LinearLayout>
                <Space
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="@dimen/slider_width_phone"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scroll_settings_text2"/>
                    <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                        android:id="@+id/speedSliderView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </LinearLayout>
                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:src="@drawable/white_dotted_line"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:text="@string/scroll_settings_text3"
                    android:layout_weight="0"/>
                <Space
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"/>
                <Switch
                    android:id="@+id/invertYAxisSwitch"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:thumbTint="@drawable/switch_thumb"
                    android:trackTint="@drawable/switch_track"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0">
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/scroll_settings_text4"
                        android:layout_weight="0"/>
                    <Space
                        android:layout_width="20dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"/>
                    <Switch
                        android:id="@+id/resetOnEdgeSwitch"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:thumbTint="@drawable/switch_thumb"
                        android:trackTint="@drawable/switch_track"/>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
                <Space
                    android:layout_width="15dp"
                    android:layout_height="7dp"
                    android:layout_weight="0"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/font_size_text_phone"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/scroll_settings_text5"
                        android:layout_weight="0"/>
                    <Space
                        android:layout_width="20dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"/>
                    <Switch
                        android:id="@+id/scrollFromLastPositionSwitch"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:thumbTint="@drawable/switch_thumb"
                        android:trackTint="@drawable/switch_track"/>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/font_size_text_phone"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/scroll_settings_text6"
                    android:layout_weight="0"/>
                <Space
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"/>
                <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                    android:id="@+id/autoReleaseIntervalSliderView"
                    android:layout_width="@dimen/slider_width_phone"
                    android:layout_height="@dimen/slider_height_phone"
                    android:layout_weight="0"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"/>
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </ScrollView>
</com.zjx.jyandroid.module.keymapeditor.componentsettingsview.ScrollComponentSettingsView>
