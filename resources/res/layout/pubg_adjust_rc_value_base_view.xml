<?xml version="1.0" encoding="utf-8"?>
<com.zjx.jyandroid.Extensions.pubg.AdjustRCValueBaseView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#6a000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_weight="0"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">
            <com.zjx.jysdk.uicomponent.FilledSliderWithButtons
                android:id="@+id/slider"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_weight="0">
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <Button
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:id="@+id/dynamicRCButton"
                android:background="@drawable/rounded_button_background_5dp"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:text="@string/adjust_rc_value_base_view_text2"
                android:layout_weight="0"
                android:backgroundTint="@color/jy_blue_1"/>
            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content"/>
            <Button
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:id="@+id/coefficientButton"
                android:background="@drawable/rounded_button_background_5dp"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:text="@string/adjust_rc_value_base_view_text3"
                android:backgroundTint="@color/jy_blue_1"/>
            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content"/>
            <Button
                android:textSize="@dimen/font_size_text_phone"
                android:textColor="@color/white"
                android:id="@+id/deleteButton"
                android:background="@drawable/rounded_button_background_5dp"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:text="@string/adjust_rc_value_base_view_text4"
                android:backgroundTint="@color/danger_red"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</com.zjx.jyandroid.Extensions.pubg.AdjustRCValueBaseView>
